{
  "$defs": {
    "FinalEditorialCategory": {
      "description": "The bounded editorial dimensions T22 evaluates on the assembled recap.",
      "enum": [
        "story_beat_coverage",
        "narrative_structure",
        "scene_completeness",
        "character_identity_continuity",
        "character_state_continuity",
        "location_continuity",
        "prop_and_wardrobe_continuity",
        "visual_contradiction",
        "shot_to_shot_continuity",
        "transition_coherence",
        "narration_visual_agreement",
        "caption_narration_agreement",
        "comprehensibility",
        "setup_and_payoff",
        "narrative_jump",
        "repetition",
        "pacing",
        "dead_air",
        "ending_completeness",
        "script_contradiction",
        "source_contradiction"
      ],
      "title": "FinalEditorialCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One recomputed editorial dimension result.\n\n``score`` is descriptive only. The gate reads findings, never this number:\na high average must never conceal a blocking issue.",
  "properties": {
    "applicable": {
      "default": true,
      "title": "Applicable",
      "type": "boolean"
    },
    "blocking_finding_count": {
      "default": 0,
      "minimum": 0,
      "title": "Blocking Finding Count",
      "type": "integer"
    },
    "category": {
      "$ref": "#/$defs/FinalEditorialCategory"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "review_finding_count": {
      "default": 0,
      "minimum": 0,
      "title": "Review Finding Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "summary": {
      "default": "",
      "maxLength": 500,
      "title": "Summary",
      "type": "string"
    },
    "warning_finding_count": {
      "default": 0,
      "minimum": 0,
      "title": "Warning Finding Count",
      "type": "integer"
    }
  },
  "required": [
    "category",
    "score",
    "confidence"
  ],
  "title": "FinalEditorialDimension",
  "type": "object"
}
