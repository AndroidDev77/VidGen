{
  "$defs": {
    "UsageUnit": {
      "enum": [
        "INPUT_TOKEN",
        "OUTPUT_TOKEN",
        "CACHED_INPUT_TOKEN",
        "AUDIO_INPUT_SECOND",
        "AUDIO_OUTPUT_SECOND",
        "IMAGE_INPUT",
        "IMAGE_OUTPUT",
        "VIDEO_OUTPUT_SECOND",
        "REQUEST",
        "STORAGE_BYTE",
        "COMPUTE_SECOND"
      ],
      "title": "UsageUnit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active": {
      "default": true,
      "title": "Active",
      "type": "boolean"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "effective_end": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective End"
    },
    "effective_start": {
      "format": "date-time",
      "title": "Effective Start",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "pricing_version_id": {
      "format": "uuid",
      "title": "Pricing Version Id",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_reference": {
      "title": "Source Reference",
      "type": "string"
    },
    "unit_price": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Unit Price"
    },
    "unit_size": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Unit Size"
    },
    "usage_unit": {
      "$ref": "#/$defs/UsageUnit"
    },
    "verification_date": {
      "format": "date",
      "title": "Verification Date",
      "type": "string"
    }
  },
  "required": [
    "pricing_version_id",
    "provider",
    "model",
    "operation",
    "usage_unit",
    "unit_size",
    "unit_price",
    "currency",
    "effective_start",
    "source_reference",
    "verification_date"
  ],
  "title": "PricingRate",
  "type": "object"
}
