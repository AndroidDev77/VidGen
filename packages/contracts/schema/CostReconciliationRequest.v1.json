{
  "additionalProperties": false,
  "properties": {
    "actual_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Actual Amount"
    },
    "billable": {
      "default": true,
      "title": "Billable",
      "type": "boolean"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "reservation_id": {
      "format": "uuid",
      "title": "Reservation Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "reservation_id",
    "idempotency_key",
    "actual_amount"
  ],
  "title": "CostReconciliationRequest",
  "type": "object"
}
