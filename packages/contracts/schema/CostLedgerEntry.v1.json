{
  "$defs": {
    "LedgerStatus": {
      "enum": [
        "ESTIMATED",
        "RESERVED",
        "COMMITTED",
        "PARTIALLY_RECONCILED",
        "RELEASED",
        "REJECTED"
      ],
      "title": "LedgerStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Actual Amount"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "currency": {
      "title": "Currency",
      "type": "string"
    },
    "estimated_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Estimated Amount"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "pricing_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pricing Version Id"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "provider_attempt_id": {
      "format": "uuid",
      "title": "Provider Attempt Id",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "released_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Released Amount"
    },
    "reserved_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Reserved Amount"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/LedgerStatus"
    }
  },
  "required": [
    "id",
    "project_id",
    "provider_attempt_id",
    "provider",
    "model",
    "operation",
    "reason",
    "pricing_version_id",
    "currency",
    "estimated_amount",
    "reserved_amount",
    "actual_amount",
    "released_amount",
    "status",
    "idempotency_key",
    "created_at"
  ],
  "title": "CostLedgerEntry",
  "type": "object"
}
