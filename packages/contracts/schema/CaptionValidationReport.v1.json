{
  "$defs": {
    "CaptionValidationDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "cue_sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cue Sequence"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "CaptionValidationDiagnostic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjustment_codes": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Adjustment Codes",
      "type": "array"
    },
    "caption_identity": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Caption Identity",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/CaptionValidationDiagnostic"
      },
      "maxItems": 1000,
      "title": "Diagnostics",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    }
  },
  "required": [
    "valid",
    "caption_identity"
  ],
  "title": "CaptionValidationReport",
  "type": "object"
}
