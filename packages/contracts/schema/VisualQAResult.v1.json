{
  "$defs": {
    "VisualQAAdjudication": {
      "additionalProperties": false,
      "description": "The bounded second opinion. Both the original and this result persist.",
      "properties": {
        "adjudication_id": {
          "format": "uuid",
          "title": "Adjudication Id",
          "type": "string"
        },
        "adjudicator_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Adjudicator Confidence",
          "type": "number"
        },
        "adjudicator_model": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Adjudicator Model",
          "type": "string"
        },
        "adjudicator_provider": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Adjudicator Provider",
          "type": "string"
        },
        "attempts_used": {
          "maximum": 3,
          "minimum": 1,
          "title": "Attempts Used",
          "type": "integer"
        },
        "decided": {
          "title": "Decided",
          "type": "boolean"
        },
        "disagreement_summary": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Disagreement Summary",
          "type": "array"
        },
        "first_pass_model": {
          "maxLength": 128,
          "minLength": 1,
          "title": "First Pass Model",
          "type": "string"
        },
        "first_pass_provider": {
          "maxLength": 64,
          "minLength": 1,
          "title": "First Pass Provider",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "resulting_outcome_hint": {
          "$ref": "#/$defs/VisualQAOutcome"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "triggered_by": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Triggered By",
          "type": "array"
        }
      },
      "required": [
        "adjudication_id",
        "policy_version",
        "triggered_by",
        "first_pass_provider",
        "first_pass_model",
        "adjudicator_provider",
        "adjudicator_model",
        "adjudicator_confidence",
        "decided",
        "resulting_outcome_hint",
        "attempts_used"
      ],
      "title": "VisualQAAdjudication",
      "type": "object"
    },
    "VisualQABoundingBox": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "VisualQABoundingBox",
      "type": "object"
    },
    "VisualQADeterministicMetric": {
      "additionalProperties": false,
      "description": "One measured deterministic check with its threshold and outcome.",
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "diagnostic_code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Diagnostic Code",
          "type": "string"
        },
        "evidence_sample_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sample Id"
        },
        "evidence_timestamp_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Timestamp Us"
        },
        "measurement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement"
        },
        "message": {
          "default": "",
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "pass",
            "warning",
            "hard_failure",
            "not_applicable"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "repair_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualQARepairCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "tool": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "default": "",
          "maxLength": 128,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "outcome",
        "tool",
        "diagnostic_code"
      ],
      "title": "VisualQADeterministicMetric",
      "type": "object"
    },
    "VisualQADeterministicReport": {
      "additionalProperties": false,
      "description": "Everything measured before any paid visual-agent request.",
      "properties": {
        "check_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Check Version",
          "type": "string"
        },
        "frame_rate": {
          "default": "",
          "maxLength": 32,
          "title": "Frame Rate",
          "type": "string"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "measured_duration_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Duration Us"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/VisualQADeterministicMetric"
          },
          "maxItems": 64,
          "title": "Metrics",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_type": {
          "$ref": "#/$defs/VisualQATargetType"
        },
        "usable": {
          "title": "Usable",
          "type": "boolean"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "check_version",
        "target_type",
        "usable"
      ],
      "title": "VisualQADeterministicReport",
      "type": "object"
    },
    "VisualQADimension": {
      "enum": [
        "character_identity",
        "character_count",
        "location",
        "wardrobe_and_state",
        "action_and_motion",
        "composition",
        "anatomy_and_artifacts",
        "continuity_and_style"
      ],
      "title": "VisualQADimension",
      "type": "string"
    },
    "VisualQADimensionResult": {
      "additionalProperties": false,
      "description": "One rubric dimension as validated by application code.",
      "properties": {
        "applicable": {
          "default": true,
          "title": "Applicable",
          "type": "boolean"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "dimension": {
          "$ref": "#/$defs/VisualQADimension"
        },
        "effective_weight": {
          "maximum": 100,
          "minimum": 0,
          "title": "Effective Weight",
          "type": "number"
        },
        "evaluator": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Evaluator",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/VisualQAFinding"
          },
          "maxItems": 16,
          "title": "Findings",
          "type": "array"
        },
        "hard_failure_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Hard Failure Codes",
          "type": "array"
        },
        "model": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "raw_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Raw Score",
          "type": "number"
        },
        "repair_codes": {
          "items": {
            "$ref": "#/$defs/VisualQARepairCode"
          },
          "maxItems": 8,
          "title": "Repair Codes",
          "type": "array"
        },
        "rubric_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Rubric Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "warning_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Warning Codes",
          "type": "array"
        },
        "weight": {
          "maximum": 100,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "weighted_contribution": {
          "maximum": 100,
          "minimum": 0,
          "title": "Weighted Contribution",
          "type": "number"
        }
      },
      "required": [
        "dimension",
        "raw_score",
        "weight",
        "effective_weight",
        "weighted_contribution",
        "confidence",
        "evaluator",
        "model",
        "rubric_version"
      ],
      "title": "VisualQADimensionResult",
      "type": "object"
    },
    "VisualQAEvidence": {
      "additionalProperties": false,
      "description": "A concrete, replayable pointer to what a finding is based on.",
      "properties": {
        "bounding_box": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualQABoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "compared_reference_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compared Reference Asset Id"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "contact_sheet_position": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact Sheet Position"
        },
        "entity_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "entity_kind": {
          "default": "none",
          "enum": [
            "character",
            "location",
            "prop",
            "state",
            "none"
          ],
          "title": "Entity Kind",
          "type": "string"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "$ref": "#/$defs/VisualQAEvidenceType"
        },
        "explanation": {
          "default": "",
          "maxLength": 500,
          "title": "Explanation",
          "type": "string"
        },
        "frame_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Asset Id"
        },
        "measurement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement"
        },
        "prop_reference": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prop Reference"
        },
        "sample_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "shot_relative_timestamp_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shot Relative Timestamp Us"
        },
        "source_asset_id": {
          "format": "uuid",
          "title": "Source Asset Id",
          "type": "string"
        },
        "source_relative_timestamp_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Relative Timestamp Us"
        }
      },
      "required": [
        "evidence_id",
        "evidence_type",
        "source_asset_id"
      ],
      "title": "VisualQAEvidence",
      "type": "object"
    },
    "VisualQAEvidenceType": {
      "enum": [
        "sample_frame",
        "reference_comparison",
        "deterministic_measurement",
        "whole_file"
      ],
      "title": "VisualQAEvidenceType",
      "type": "string"
    },
    "VisualQAFinding": {
      "additionalProperties": false,
      "description": "One actionable observation with its evidence and structured correction.",
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "dimension": {
          "$ref": "#/$defs/VisualQADimension"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/VisualQAEvidence"
          },
          "maxItems": 16,
          "title": "Evidence",
          "type": "array"
        },
        "finding_id": {
          "format": "uuid",
          "title": "Finding Id",
          "type": "string"
        },
        "proposed_correction": {
          "default": "",
          "maxLength": 500,
          "title": "Proposed Correction",
          "type": "string"
        },
        "repair_codes": {
          "items": {
            "$ref": "#/$defs/VisualQARepairCode"
          },
          "maxItems": 8,
          "title": "Repair Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "hard_failure"
          ],
          "title": "Severity",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "dimension",
        "severity",
        "code",
        "summary",
        "confidence"
      ],
      "title": "VisualQAFinding",
      "type": "object"
    },
    "VisualQAOutcome": {
      "enum": [
        "PASS",
        "FAIL",
        "REVIEW"
      ],
      "title": "VisualQAOutcome",
      "type": "string"
    },
    "VisualQARepairCode": {
      "description": "The bounded taxonomy T21 consumes. Adding a member is a version change.",
      "enum": [
        "WRONG_CHARACTER_IDENTITY",
        "MISSING_PRIMARY_CHARACTER",
        "EXTRA_CHARACTER",
        "WRONG_CHARACTER_COUNT",
        "WRONG_WARDROBE",
        "WRONG_CHARACTER_STATE",
        "WRONG_LOCATION",
        "WRONG_LOCATION_STATE",
        "MISSING_REQUIRED_PROP",
        "WRONG_PROP_OWNERSHIP",
        "MISSING_MANDATORY_ACTION",
        "WRONG_ACTION",
        "INSUFFICIENT_MOTION",
        "EXCESSIVE_MOTION",
        "CAMERA_PLAN_MISMATCH",
        "COMPOSITION_MISMATCH",
        "SCREEN_DIRECTION_CONTRADICTION",
        "FACE_BREAKAGE",
        "ANATOMY_BREAKAGE",
        "UNINTENDED_TEXT",
        "STYLE_DRIFT",
        "CONTINUITY_BREAK",
        "BLACK_VIDEO",
        "EXCESSIVE_FREEZE",
        "EXCESSIVE_FLICKER",
        "DURATION_MISMATCH",
        "DECODE_FAILURE",
        "PROMPT_TOO_COMPLEX",
        "TOO_MANY_CHARACTERS",
        "TOO_MANY_REFERENCES",
        "AMBIGUOUS_VISUAL_EVIDENCE",
        "HUMAN_REVIEW_REQUIRED"
      ],
      "title": "VisualQARepairCode",
      "type": "string"
    },
    "VisualQARepairRecommendation": {
      "additionalProperties": false,
      "description": "What T21 should consider. T20 never executes any of it.",
      "properties": {
        "executed": {
          "const": false,
          "default": false,
          "title": "Executed",
          "type": "boolean"
        },
        "rationale": {
          "default": "",
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "repair_codes": {
          "items": {
            "$ref": "#/$defs/VisualQARepairCode"
          },
          "maxItems": 16,
          "title": "Repair Codes",
          "type": "array"
        },
        "routing": {
          "$ref": "#/$defs/VisualQARoutingRecommendation"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "routing"
      ],
      "title": "VisualQARepairRecommendation",
      "type": "object"
    },
    "VisualQARoutingRecommendation": {
      "description": "A recommendation only. T20 never executes a repair or a reroute.",
      "enum": [
        "NONE",
        "TARGETED_REPAIR",
        "PROMPT_SIMPLIFICATION",
        "NEW_SEED",
        "COMPOSITION_SPLIT",
        "HUMAN_REVIEW"
      ],
      "title": "VisualQARoutingRecommendation",
      "type": "string"
    },
    "VisualQASample": {
      "additionalProperties": false,
      "description": "One deterministically selected, decoded and hashed frame.",
      "properties": {
        "actual_timestamp_us": {
          "minimum": 0,
          "title": "Actual Timestamp Us",
          "type": "integer"
        },
        "contact_sheet_position": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact Sheet Position"
        },
        "frame_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Asset Id"
        },
        "frame_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Frame Sha256",
          "type": "string"
        },
        "measurements": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Measurements",
          "type": "object"
        },
        "requested_timestamp_us": {
          "minimum": 0,
          "title": "Requested Timestamp Us",
          "type": "integer"
        },
        "sample_id": {
          "format": "uuid",
          "title": "Sample Id",
          "type": "string"
        },
        "sample_type": {
          "$ref": "#/$defs/VisualQASampleType"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_reason": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Selection Reason",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "shot_relative_timestamp_us": {
          "minimum": 0,
          "title": "Shot Relative Timestamp Us",
          "type": "integer"
        },
        "source_asset_id": {
          "format": "uuid",
          "title": "Source Asset Id",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "sequence",
        "sample_type",
        "requested_timestamp_us",
        "actual_timestamp_us",
        "shot_relative_timestamp_us",
        "frame_sha256",
        "source_asset_id",
        "selection_reason"
      ],
      "title": "VisualQASample",
      "type": "object"
    },
    "VisualQASampleType": {
      "description": "Why the deterministic sampler selected a timestamp.",
      "enum": [
        "keyframe_image",
        "first_frame",
        "last_frame",
        "midpoint",
        "coverage",
        "clause_boundary",
        "action_boundary",
        "camera_change",
        "transition_boundary",
        "action_window",
        "high_motion",
        "low_motion",
        "deterministic_warning",
        "face_track",
        "ocr"
      ],
      "title": "VisualQASampleType",
      "type": "string"
    },
    "VisualQASamplingManifest": {
      "additionalProperties": false,
      "description": "The complete, ordered, deduplicated sample plan bound into QA identity.",
      "properties": {
        "contact_sheet_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact Sheet Asset Id"
        },
        "contact_sheet_columns": {
          "default": 4,
          "maximum": 8,
          "minimum": 1,
          "title": "Contact Sheet Columns",
          "type": "integer"
        },
        "measured_duration_us": {
          "minimum": 0,
          "title": "Measured Duration Us",
          "type": "integer"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/VisualQASample"
          },
