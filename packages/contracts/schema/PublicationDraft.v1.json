{
  "$defs": {
    "PrivacyState": {
      "description": "The privacy states YouTube accepts. Mirrors the capability registry.",
      "enum": [
        "private",
        "unlisted",
        "public"
      ],
      "title": "PrivacyState",
      "type": "string"
    },
    "PublicationMetadata": {
      "additionalProperties": false,
      "description": "The editable YouTube metadata for one publication, at one version.\n\nLimits come from the capability registry and are enforced twice: here, and\nagain by the provider request builder immediately before a write.",
      "properties": {
        "caption_language": {
          "default": "en",
          "maxLength": 16,
          "minLength": 2,
          "title": "Caption Language",
          "type": "string"
        },
        "caption_track_name": {
          "default": "VidGen recap",
          "maxLength": 150,
          "minLength": 1,
          "title": "Caption Track Name",
          "type": "string"
        },
        "category_id": {
          "default": "24",
          "maxLength": 8,
          "minLength": 1,
          "pattern": "^[0-9]+$",
          "title": "Category Id",
          "type": "string"
        },
        "contains_synthetic_media": {
          "default": true,
          "title": "Contains Synthetic Media",
          "type": "boolean"
        },
        "default_language": {
          "default": "en",
          "maxLength": 16,
          "minLength": 2,
          "title": "Default Language",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 5000,
          "title": "Description",
          "type": "string"
        },
        "embeddable": {
          "default": true,
          "title": "Embeddable",
          "type": "boolean"
        },
        "initial_privacy": {
          "const": "private",
          "default": "private",
          "title": "Initial Privacy",
          "type": "string"
        },
        "made_for_kids": {
          "default": false,
          "title": "Made For Kids",
          "type": "boolean"
        },
        "metadata_version": {
          "default": 1,
          "minimum": 1,
          "title": "Metadata Version",
          "type": "integer"
        },
        "notify_subscribers": {
          "default": false,
          "title": "Notify Subscribers",
          "type": "boolean"
        },
        "requested_privacy": {
          "$ref": "#/$defs/PrivacyState",
          "default": "private"
        },
        "scheduled_publish_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled Publish At"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 60,
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "PublicationMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The versioned, user-editable draft a publication is started from.\n\nA draft is created deterministically from existing project metadata. It is\nnever regenerated over a user's edits: the pipeline reads the persisted\ndraft, and a reload or a resume reads the same row.",
  "properties": {
    "channel_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_\\-]+$",
      "title": "Channel Id",
      "type": "string"
    },
    "connection_id": {
      "format": "uuid",
      "title": "Connection Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "draft_id": {
      "format": "uuid",
      "title": "Draft Id",
      "type": "string"
    },
    "final_editorial_run_id": {
      "format": "uuid",
      "title": "Final Editorial Run Id",
      "type": "string"
    },
    "final_render_asset_id": {
      "format": "uuid",
      "title": "Final Render Asset Id",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/PublicationMetadata"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "thumbnail_asset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thumbnail Asset Id"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "draft_id",
    "project_id",
    "final_render_asset_id",
    "final_editorial_run_id",
    "connection_id",
    "channel_id",
    "metadata",
    "input_hash",
    "created_at",
    "updated_at"
  ],
  "title": "PublicationDraft",
  "type": "object"
}
