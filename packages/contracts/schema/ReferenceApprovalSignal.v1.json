{
  "additionalProperties": false,
  "description": "A durable approval decision, delivered to the waiting T19 workflow.\n\nCarries identifiers only: the approved rows, their lineage and the exact\nstoryboard the binding must apply to are all resolved from the database by\nthe activity, so no reference payload enters workflow history.",
  "properties": {
    "approval_id": {
      "format": "uuid",
      "title": "Approval Id",
      "type": "string"
    },
    "approved_reference_set_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Approved Reference Set Ids",
      "type": "array"
    },
    "idempotency_key": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "reference_run_id": {
      "format": "uuid",
      "title": "Reference Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "storyboard_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Storyboard Run Id"
    }
  },
  "required": [
    "project_id",
    "reference_run_id",
    "approval_id",
    "idempotency_key"
  ],
  "title": "ReferenceApprovalSignal",
  "type": "object"
}
