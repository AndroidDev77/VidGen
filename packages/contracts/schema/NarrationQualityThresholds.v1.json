      "default": 1.5,
      "minimum": 0,
      "title": "Max Internal Silence",
      "type": "number"
    },
    "max_leading_silence": {
      "default": 0.5,
      "minimum": 0,
      "title": "Max Leading Silence",
      "type": "number"
    },
    "max_trailing_silence": {
      "default": 0.7,
      "minimum": 0,
      "title": "Max Trailing Silence",
      "type": "number"
    },
    "max_wpm": {
      "default": 220,
      "exclusiveMinimum": 0,
      "title": "Max Wpm",
      "type": "number"
    },
    "min_alignment_coverage": {
      "default": 0.9,
