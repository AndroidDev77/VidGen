{
  "$defs": {
    "ShotFailureClass": {
      "enum": [
        "transient_provider_failure",
        "rate_limit",
        "provider_timeout",
        "polling_interruption",
        "download_interruption",
        "worker_interruption",
        "temporary_storage_failure",
        "budget_denial",
        "deterministic_configuration_failure",
        "invalid_lineage",
        "unsupported_capability",
        "corrupt_provider_output",
        "technical_validation_failure",
        "visual_qa_failure",
        "visual_qa_review_required",
        "cancellation",
        "unknown_failure"
      ],
      "title": "ShotFailureClass",
      "type": "string"
    },
    "ShotWorkflowFailure": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "classification": {
          "$ref": "#/$defs/ShotFailureClass"
        },
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "classification",
        "code",
        "retryable",
        "attempt",
        "message"
      ],
      "title": "ShotWorkflowFailure",
      "type": "object"
    },
    "ShotWorkflowProgress": {
      "additionalProperties": false,
      "properties": {
        "cost_microusd": {
          "default": 0,
          "minimum": 0,
          "title": "Cost Microusd",
          "type": "integer"
        },
        "current_attempt": {
          "minimum": 0,
          "title": "Current Attempt",
          "type": "integer"
        },
        "current_stage": {
          "title": "Current Stage",
          "type": "string"
        },
        "last_checkpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Checkpoint"
        },
        "last_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShotWorkflowFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_keyframe_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Keyframe Asset Id"
        },
        "selected_video_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Video Asset Id"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "state": {
          "$ref": "#/$defs/ShotWorkflowStatus"
        },
        "t14_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T14 Run Id"
        },
        "t15_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T15 Run Id"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "warning_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Warning Codes",
          "type": "array"
        }
      },
      "required": [
        "state",
        "current_stage",
        "current_attempt"
      ],
      "title": "ShotWorkflowProgress",
      "type": "object"
    },
    "ShotWorkflowStatus": {
      "enum": [
        "defined",
        "prompting",
        "keyframe_generating",
        "keyframe_qa",
        "animating",
        "video_qa",
        "locked",
        "failed",
        "cancelled"
      ],
      "title": "ShotWorkflowStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "identity_hash": {
      "title": "Identity Hash",
      "type": "string"
    },
    "progress": {
      "$ref": "#/$defs/ShotWorkflowProgress"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workflow_id": {
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "workflow_id",
    "identity_hash",
    "progress"
  ],
  "title": "ShotWorkflowQueryResult",
  "type": "object"
}
