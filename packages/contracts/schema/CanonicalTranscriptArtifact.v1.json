{
  "$defs": {
    "SpeakerTurn": {
      "additionalProperties": false,
      "properties": {
        "alternate_labels": {
          "items": {
            "type": "string"
          },
          "title": "Alternate Labels",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "source_chunk_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Chunk Ids",
          "type": "array"
        },
        "speaker_label": {
          "pattern": "^speaker_[0-9]{3}$",
          "title": "Speaker Label",
          "type": "string"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/TranscriptionWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "sequence",
        "speaker_label",
        "start_seconds",
        "end_seconds",
        "source_chunk_ids",
        "provider",
        "model"
      ],
      "title": "SpeakerTurn",
      "type": "object"
    },
    "TimeInterval": {
      "additionalProperties": false,
      "properties": {
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        }
      },
      "required": [
        "start_seconds",
        "end_seconds"
      ],
      "title": "TimeInterval",
      "type": "object"
    },
    "TranscriptCoverage": {
      "additionalProperties": false,
      "properties": {
        "covered_voiced_seconds": {
          "minimum": 0,
          "title": "Covered Voiced Seconds",
          "type": "number"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ratio",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "uncovered_intervals": {
          "items": {
            "$ref": "#/$defs/TimeInterval"
          },
          "title": "Uncovered Intervals",
          "type": "array"
        },
        "voiced_seconds": {
          "minimum": 0,
          "title": "Voiced Seconds",
          "type": "number"
        }
      },
      "required": [
        "voiced_seconds",
        "covered_voiced_seconds",
        "ratio",
        "passed"
      ],
      "title": "TranscriptCoverage",
      "type": "object"
    },
    "TranscriptSegment": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "source_chunk_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Chunk Ids",
          "type": "array"
        },
        "speaker_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Label"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/TranscriptWord"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "sequence",
        "start_seconds",
        "end_seconds",
        "text",
        "source_chunk_ids"
      ],
      "title": "TranscriptSegment",
      "type": "object"
    },
    "TranscriptWord": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "start_seconds",
        "end_seconds"
      ],
      "title": "TranscriptWord",
      "type": "object"
    },
    "TranscriptionWarning": {
      "additionalProperties": false,
      "properties": {
        "chunk_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Sequence"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "TranscriptionWarning",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage": {
      "$ref": "#/$defs/TranscriptCoverage"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/TranscriptSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "source_audio_asset_id": {
      "format": "uuid",
      "title": "Source Audio Asset Id",
      "type": "string"
    },
    "source_video_id": {
      "format": "uuid",
      "title": "Source Video Id",
      "type": "string"
    },
    "speaker_turns": {
      "items": {
        "$ref": "#/$defs/SpeakerTurn"
      },
      "title": "Speaker Turns",
      "type": "array"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "transcript_id": {
      "format": "uuid",
      "title": "Transcript Id",
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/TranscriptionWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "run_id",
    "transcript_id",
    "source_video_id",
    "source_audio_asset_id",
    "text",
    "segments",
    "speaker_turns",
    "coverage"
  ],
  "title": "CanonicalTranscriptArtifact",
  "type": "object"
}
