{
  "$defs": {
    "NarrationAlignment": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "insertions": {
          "items": {
            "type": "string"
          },
          "title": "Insertions",
          "type": "array"
        },
        "omissions": {
          "items": {
            "type": "string"
          },
          "title": "Omissions",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "substitutions": {
          "items": {
            "type": "string"
          },
          "title": "Substitutions",
          "type": "array"
        },
        "timings": {
          "items": {
            "$ref": "#/$defs/NarrationWordTiming"
          },
          "title": "Timings",
          "type": "array"
        }
      },
      "required": [
        "timings",
        "coverage"
      ],
      "title": "NarrationAlignment",
      "type": "object"
    },
    "NarrationPreviewManifest": {
      "additionalProperties": false,
      "properties": {
        "concatenation_parameters": {
          "additionalProperties": true,
          "title": "Concatenation Parameters",
          "type": "object"
        },
        "input_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "narration_asset_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Narration Asset Ids",
          "type": "array"
        },
        "narration_run_id": {
          "format": "uuid",
          "title": "Narration Run Id",
          "type": "string"
        },
        "output_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "preview_asset_id": {
          "format": "uuid",
          "title": "Preview Asset Id",
          "type": "string"
        },
        "preview_duration_seconds": {
          "minimum": 0,
          "title": "Preview Duration Seconds",
          "type": "number"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "script_id": {
          "format": "uuid",
          "title": "Script Id",
          "type": "string"
        },
        "script_version": {
          "exclusiveMinimum": 0,
          "title": "Script Version",
          "type": "integer"
        },
        "segment_durations_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Segment Durations Seconds",
          "type": "array"
        },
        "segment_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        },
        "voice_profile_id": {
          "format": "uuid",
          "title": "Voice Profile Id",
          "type": "string"
        },
        "voice_profile_version": {
          "exclusiveMinimum": 0,
          "title": "Voice Profile Version",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "word_timing_references": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Word Timing References",
          "type": "array"
        }
      },
      "required": [
        "script_id",
        "script_version",
        "narration_run_id",
        "voice_profile_id",
        "voice_profile_version",
        "segment_ids",
        "narration_asset_ids",
        "segment_durations_seconds",
        "word_timing_references",
        "concatenation_parameters",
        "preview_duration_seconds",
        "preview_asset_id",
        "input_hash",
        "output_hash",
        "provenance"
      ],
      "title": "NarrationPreviewManifest",
      "type": "object"
    },
    "NarrationQualityDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "measured_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Value"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "NarrationQualityDiagnostic",
      "type": "object"
    },
    "NarrationQualityReport": {
      "additionalProperties": false,
      "properties": {
        "alignment_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Alignment Coverage",
          "type": "number"
        },
        "clipping_ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Clipping Ratio",
          "type": "number"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/NarrationQualityDiagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "leading_silence_seconds": {
          "minimum": 0,
          "title": "Leading Silence Seconds",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "speaking_rate_wpm": {
          "minimum": 0,
          "title": "Speaking Rate Wpm",
          "type": "number"
        },
        "trailing_silence_seconds": {
          "minimum": 0,
          "title": "Trailing Silence Seconds",
          "type": "number"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "clipping_ratio",
        "leading_silence_seconds",
        "trailing_silence_seconds",
        "speaking_rate_wpm",
        "alignment_coverage"
      ],
      "title": "NarrationQualityReport",
      "type": "object"
    },
    "NarrationSegmentResult": {
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "$ref": "#/$defs/NarrationAlignment"
        },
        "audio_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Audio Sha256",
          "type": "string"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "generation_identity": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Generation Identity",
          "type": "string"
        },
        "normalized_asset_id": {
          "format": "uuid",
          "title": "Normalized Asset Id",
          "type": "string"
        },
        "quality_report": {
          "$ref": "#/$defs/NarrationQualityReport"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "script_segment_id": {
          "format": "uuid",
          "title": "Script Segment Id",
          "type": "string"
        },
        "selected_attempt_id": {
          "format": "uuid",
          "title": "Selected Attempt Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "script_segment_id",
        "sequence",
        "generation_identity",
        "normalized_asset_id",
        "duration_seconds",
        "audio_sha256",
        "alignment",
        "quality_report",
        "selected_attempt_id"
      ],
      "title": "NarrationSegmentResult",
      "type": "object"
    },
    "NarrationWordTiming": {
      "additionalProperties": false,
      "properties": {
        "comparison_token": {
          "title": "Comparison Token",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "punctuation": {
          "default": "",
          "title": "Punctuation",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "word": {
          "title": "Word",
          "type": "string"
        },
        "word_index": {
          "minimum": 0,
          "title": "Word Index",
          "type": "integer"
        }
      },
      "required": [
        "word_index",
        "word",
        "comparison_token",
        "start_seconds",
        "end_seconds",
        "confidence"
      ],
      "title": "NarrationWordTiming",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "narration_run_id": {
      "format": "uuid",
      "title": "Narration Run Id",
      "type": "string"
    },
    "preview": {
      "anyOf": [
        {
          "$ref": "#/$defs/NarrationPreviewManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "preview_manifest_asset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview Manifest Asset Id"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/NarrationSegmentResult"
      },
      "title": "Segments",
      "type": "array"
    },
    "status": {
      "enum": [
        "narration_complete",
        "narration_failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "narration_run_id",
    "project_id",
    "status",
    "segments"
  ],
  "title": "NarrationResult",
  "type": "object"
}
