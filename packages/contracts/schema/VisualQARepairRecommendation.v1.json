{
  "$defs": {
    "VisualQARepairCode": {
      "description": "The bounded taxonomy T21 consumes. Adding a member is a version change.",
      "enum": [
        "WRONG_CHARACTER_IDENTITY",
        "MISSING_PRIMARY_CHARACTER",
        "EXTRA_CHARACTER",
        "WRONG_CHARACTER_COUNT",
        "WRONG_WARDROBE",
        "WRONG_CHARACTER_STATE",
        "WRONG_LOCATION",
        "WRONG_LOCATION_STATE",
        "MISSING_REQUIRED_PROP",
        "WRONG_PROP_OWNERSHIP",
        "MISSING_MANDATORY_ACTION",
        "WRONG_ACTION",
        "INSUFFICIENT_MOTION",
        "EXCESSIVE_MOTION",
        "CAMERA_PLAN_MISMATCH",
        "COMPOSITION_MISMATCH",
        "SCREEN_DIRECTION_CONTRADICTION",
        "FACE_BREAKAGE",
        "ANATOMY_BREAKAGE",
        "UNINTENDED_TEXT",
        "STYLE_DRIFT",
        "CONTINUITY_BREAK",
        "BLACK_VIDEO",
        "EXCESSIVE_FREEZE",
        "EXCESSIVE_FLICKER",
        "DURATION_MISMATCH",
        "DECODE_FAILURE",
        "PROMPT_TOO_COMPLEX",
        "TOO_MANY_CHARACTERS",
        "TOO_MANY_REFERENCES",
        "AMBIGUOUS_VISUAL_EVIDENCE",
        "HUMAN_REVIEW_REQUIRED"
      ],
      "title": "VisualQARepairCode",
      "type": "string"
    },
    "VisualQARoutingRecommendation": {
      "description": "A recommendation only. T20 never executes a repair or a reroute.",
      "enum": [
        "NONE",
        "TARGETED_REPAIR",
        "PROMPT_SIMPLIFICATION",
        "NEW_SEED",
        "COMPOSITION_SPLIT",
        "HUMAN_REVIEW"
      ],
      "title": "VisualQARoutingRecommendation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "What T21 should consider. T20 never executes any of it.",
  "properties": {
    "executed": {
      "const": false,
      "default": false,
      "title": "Executed",
      "type": "boolean"
    },
    "rationale": {
      "default": "",
      "maxLength": 500,
      "title": "Rationale",
      "type": "string"
    },
    "repair_codes": {
      "items": {
        "$ref": "#/$defs/VisualQARepairCode"
      },
      "maxItems": 16,
      "title": "Repair Codes",
      "type": "array"
    },
    "routing": {
      "$ref": "#/$defs/VisualQARoutingRecommendation"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "routing"
  ],
  "title": "VisualQARepairRecommendation",
  "type": "object"
}
