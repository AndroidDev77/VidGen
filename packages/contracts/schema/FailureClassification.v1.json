{
  "$defs": {
    "FailureClass": {
      "enum": [
        "TRANSPORT",
        "TIMEOUT",
        "RATE_LIMIT",
        "AUTHENTICATION",
        "AUTHORIZATION",
        "INVALID_REQUEST",
        "PROVIDER_REJECTED",
        "CONTENT_FILTER",
        "CONTRACT_VALIDATION",
        "QUALITY_FAILURE",
        "BUDGET_EXCEEDED",
        "CANCELLED",
        "DATABASE",
        "STORAGE",
        "TEMPORAL",
        "INTERNAL",
        "UNKNOWN"
      ],
      "title": "FailureClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "diagnostic_metadata": {
      "additionalProperties": true,
      "title": "Diagnostic Metadata",
      "type": "object"
    },
    "error_code": {
      "title": "Error Code",
      "type": "string"
    },
    "failure_class": {
      "$ref": "#/$defs/FailureClass"
    },
    "provider_error_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Error Type"
    },
    "provider_http_status": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Http Status"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    },
    "sanitized_message": {
      "title": "Sanitized Message",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "failure_class",
    "error_code",
    "retryable",
    "sanitized_message"
  ],
  "title": "FailureClassification",
  "type": "object"
