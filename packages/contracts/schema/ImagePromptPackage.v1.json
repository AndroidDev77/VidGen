      "required": [
        "shot_id",
        "shot_sequence",
        "keyframe_role",
        "visual_purpose",
        "style_lock",
        "visible_character_count",
        "location_description",
        "composition",
        "shot_size",
        "camera_angle",
        "pose",
        "primary_action",
        "emotional_state"
      ],
      "title": "VisualIntent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "prompt": {
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "prompt_compiler_version": {
      "title": "Prompt Compiler Version",
      "type": "string"
    },
    "prompt_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Prompt Hash",
      "type": "string"
    },
    "provider_parameters": {
      "additionalProperties": true,
      "title": "Provider Parameters",
      "type": "object"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/ImageReferenceBinding"
      },
      "title": "References",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "template_version": {
      "title": "Template Version",
      "type": "string"
    },
    "visual_intent": {
      "$ref": "#/$defs/VisualIntent"
    }
  },
  "required": [
    "visual_intent",
    "prompt",
    "prompt_compiler_version",
    "template_version",
    "prompt_hash",
    "input_hash"
  ],
  "title": "ImagePromptPackage",
  "type": "object"
}
