{
  "$defs": {
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "reference_id": {
          "format": "uuid",
          "title": "Reference Id",
          "type": "string"
        },
        "reference_type": {
          "enum": [
            "transcript_segment",
            "speaker_turn",
            "source_scene",
            "frame",
            "contact_sheet",
            "project"
          ],
          "title": "Reference Type",
          "type": "string"
        },
        "scene_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        }
      },
      "required": [
        "reference_type",
        "reference_id"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "character_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Character Ids",
      "type": "array"
    },
    "importance": {
      "maximum": 1,
      "minimum": 0,
      "title": "Importance",
      "type": "number"
    },
    "mandatory": {
      "title": "Mandatory",
      "type": "boolean"
    },
    "payoff_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Payoff Score",
      "type": "number"
    },
    "plot_beat_id": {
      "format": "uuid",
      "title": "Plot Beat Id",
      "type": "string"
    },
    "scene_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Scene Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "source_references": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Source References",
      "type": "array"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "plot_beat_id",
    "sequence",
    "scene_ids",
    "summary",
    "importance",
    "payoff_score",
    "mandatory"
  ],
  "title": "PlotBeat",
  "type": "object"
}
