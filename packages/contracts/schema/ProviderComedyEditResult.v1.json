{
  "$defs": {
    "BeatCoverage": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "enum": [
            "covered",
            "partial",
            "missing"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/StructuredNote"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "plot_beat_id": {
          "format": "uuid",
          "title": "Plot Beat Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "segment_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        }
      },
      "required": [
        "plot_beat_id",
        "coverage",
        "mandatory"
      ],
      "title": "BeatCoverage",
      "type": "object"
    },
    "Callback": {
      "additionalProperties": false,
      "properties": {
        "callback_id": {
          "format": "uuid",
          "title": "Callback Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "payoff_segment_id": {
          "format": "uuid",
          "title": "Payoff Segment Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "setup_segment_id": {
          "format": "uuid",
          "title": "Setup Segment Id",
          "type": "string"
        }
      },
      "required": [
        "callback_id",
        "setup_segment_id",
        "payoff_segment_id",
        "description"
      ],
      "title": "Callback",
      "type": "object"
    },
    "ComedyEditResult": {
      "additionalProperties": false,
      "properties": {
        "approval_recommendation": {
          "enum": [
            "approve",
            "revise",
            "reject"
          ],
          "title": "Approval Recommendation",
          "type": "string"
        },
        "edits": {
          "items": {
            "$ref": "#/$defs/ScriptEdit"
          },
          "title": "Edits",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ComedyIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "revised_script": {
          "$ref": "#/$defs/RecapScript"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scores": {
          "$ref": "#/$defs/ComedyRubricScores"
        }
      },
      "required": [
        "scores",
        "revised_script",
        "approval_recommendation"
      ],
      "title": "ComedyEditResult",
      "type": "object"
    },
    "ComedyIssue": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "rubric_dimension": {
          "title": "Rubric Dimension",
          "type": "string"
        },
        "segment_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Id"
        },
        "severity": {
          "default": "minor",
          "enum": [
            "minor",
            "major",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "description",
        "rubric_dimension"
      ],
      "title": "ComedyIssue",
      "type": "object"
    },
    "ComedyRubricScores": {
      "additionalProperties": false,
      "properties": {
        "callback_quality": {
          "maximum": 100,
          "minimum": 0,
          "title": "Callback Quality",
          "type": "number"
        },
        "clarity": {
          "maximum": 100,
          "minimum": 0,
          "title": "Clarity",
          "type": "number"
        },
        "joke_density": {
          "maximum": 100,
          "minimum": 0,
          "title": "Joke Density",
          "type": "number"
        },
        "joke_variety": {
          "maximum": 100,
          "minimum": 0,
          "title": "Joke Variety",
          "type": "number"
        },
        "narratability": {
          "maximum": 100,
          "minimum": 0,
          "title": "Narratability",
          "type": "number"
        },
        "overall": {
          "maximum": 100,
          "minimum": 0,
          "title": "Overall",
          "type": "number"
        },
        "pacing": {
          "maximum": 100,
          "minimum": 0,
          "title": "Pacing",
          "type": "number"
        },
        "plot_fidelity": {
          "maximum": 100,
          "minimum": 0,
          "title": "Plot Fidelity",
          "type": "number"
        },
        "punchline_placement": {
          "maximum": 100,
          "minimum": 0,
          "title": "Punchline Placement",
          "type": "number"
        },
        "repetition": {
          "maximum": 100,
          "minimum": 0,
          "title": "Repetition",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "spoken_rhythm": {
          "maximum": 100,
          "minimum": 0,
          "title": "Spoken Rhythm",
          "type": "number"
        }
      },
      "required": [
        "plot_fidelity",
        "clarity",
        "joke_density",
        "joke_variety",
        "punchline_placement",
        "spoken_rhythm",
        "pacing",
        "callback_quality",
        "repetition",
        "narratability",
        "overall"
      ],
      "title": "ComedyRubricScores",
      "type": "object"
    },
    "JokeAnnotation": {
      "additionalProperties": false,
      "properties": {
        "callback_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callback Id"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "joke_id": {
          "format": "uuid",
          "title": "Joke Id",
          "type": "string"
        },
        "joke_type": {
          "enum": [
            "commentary",
            "analogy",
            "exaggeration",
            "contrast",
            "callback",
            "character_observation",
            "visual_gag",
            "wordplay"
          ],
          "title": "Joke Type",
          "type": "string"
        },
        "punchline_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "setup_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_beat_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Beat Ids",
          "type": "array"
        },
        "validation_status": {
          "default": "pending",
          "enum": [
            "pending",
            "valid",
            "invalid"
          ],
          "title": "Validation Status",
          "type": "string"
        }
      },
      "required": [
        "joke_id",
        "joke_type",
        "source_beat_ids"
      ],
      "title": "JokeAnnotation",
      "type": "object"
    },
    "RecapScript": {
      "additionalProperties": false,
      "properties": {
        "actual_word_count": {
          "minimum": 0,
          "title": "Actual Word Count",
          "type": "integer"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/StructuredNote"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "beat_coverage": {
          "items": {
            "$ref": "#/$defs/BeatCoverage"
          },
          "title": "Beat Coverage",
          "type": "array"
        },
        "callbacks": {
          "items": {
            "$ref": "#/$defs/Callback"
          },
          "title": "Callbacks",
          "type": "array"
        },
        "cold_open_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cold Open Text"
        },
        "compressed_plot_plan_id": {
          "format": "uuid",
          "title": "Compressed Plot Plan Id",
          "type": "string"
        },
        "episode_analysis_id": {
          "format": "uuid",
          "title": "Episode Analysis Id",
          "type": "string"
        },
        "humor_intensity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Humor Intensity",
          "type": "number"
        },
        "parent_script_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Script Id"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "script_id": {
          "format": "uuid",
          "title": "Script Id",
          "type": "string"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/ScriptSegment"
          },
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "target_duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Target Duration Ms",
          "type": "integer"
        },
        "target_word_count": {
          "exclusiveMinimum": 0,
          "title": "Target Word Count",
          "type": "integer"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "voice_profile_ref": {
          "minLength": 1,
          "title": "Voice Profile Ref",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/StructuredNote"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "script_id",
        "version",
        "project_id",
        "episode_analysis_id",
        "compressed_plot_plan_id",
        "target_duration_ms",
        "target_word_count",
        "actual_word_count",
        "voice_profile_ref",
        "humor_intensity",
        "segments"
      ],
      "title": "RecapScript",
      "type": "object"
    },
    "ScriptEdit": {
      "additionalProperties": false,
      "properties": {
        "changes_word_count": {
          "title": "Changes Word Count",
          "type": "boolean"
        },
        "new_text": {
          "title": "New Text",
          "type": "string"
        },
        "old_text": {
          "title": "Old Text",
          "type": "string"
        },
        "plot_beat_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Plot Beat Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rubric_dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Rubric Dimensions",
          "type": "array"
        },
        "segment_id": {
          "format": "uuid",
          "title": "Segment Id",
          "type": "string"
        },
        "was_locked": {
          "title": "Was Locked",
          "type": "boolean"
        }
      },
      "required": [
        "segment_id",
        "old_text",
        "new_text",
        "reason",
        "changes_word_count",
        "was_locked"
      ],
      "title": "ScriptEdit",
      "type": "object"
    },
    "ScriptProviderMetadata": {
      "additionalProperties": false,
      "properties": {
        "attempt_number": {
          "minimum": 1,
          "title": "Attempt Number",
          "type": "integer"
        },
        "contract_version": {
          "title": "Contract Version",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "operation": {
          "enum": [
            "compress_plot",
            "write_script",
            "edit_script"
          ],
          "title": "Operation",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "provider_request_id": {
          "title": "Provider Request Id",
          "type": "string"
        },
        "redacted_response_metadata": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Redacted Response Metadata",
          "type": "object"
        },
        "rubric_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric Version"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "validation_status": {
          "default": "pending",
          "enum": [
            "pending",
            "valid",
            "invalid"
          ],
          "title": "Validation Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/StructuredNote"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "provider",
        "model",
        "provider_request_id",
        "operation",
        "attempt_number",
        "input_hash",
        "prompt_version",
        "contract_version"
      ],
      "title": "ScriptProviderMetadata",
      "type": "object"
    },
    "ScriptSegment": {
      "additionalProperties": false,
      "properties": {
        "anonymous_speaker_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anonymous Speaker Label"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "estimated_duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Estimated Duration Ms",
          "type": "integer"
        },
        "joke_annotations": {
          "items": {
            "$ref": "#/$defs/JokeAnnotation"
          },
          "title": "Joke Annotations",
          "type": "array"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "plot_beat_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Plot Beat Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "segment_id": {
          "format": "uuid",
          "title": "Segment Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "source_scene_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Scene Ids",
          "type": "array"
        },
        "speaker_character_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Character Id"
        },
        "speaker_kind": {
          "enum": [
            "narrator",
            "character",
            "anonymous"
