{
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "format": "uuid",
      "title": "Asset Id",
      "type": "string"
    },
    "media_type": {
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ],
      "title": "Media Type",
      "type": "string"
    },
    "order": {
      "minimum": 0,
      "title": "Order",
      "type": "integer"
    },
    "required": {
      "default": false,
      "title": "Required",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_role": {
      "enum": [
        "source",
        "style",
        "character",
        "location",
        "approved"
      ],
      "title": "Semantic Role",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "sha256",
    "semantic_role",
    "order",
    "media_type"
  ],
  "title": "ImageReferenceBinding",
  "type": "object"
}
