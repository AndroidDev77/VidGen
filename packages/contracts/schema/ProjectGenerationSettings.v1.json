{
  "$defs": {
    "GenerationQuality": {
      "description": "Which Runway model tier a project may spend on.\n\n``economy`` always animates with Gen-4 Turbo. ``balanced`` animates with\nGen-4 Turbo and reserves Gen-4.5 for hero shots and bounded quality-repair\nescalations when the budget permits. ``premium`` animates every compatible\nshot with Gen-4.5 and refuses the run rather than silently downgrading.",
      "enum": [
        "economy",
        "balanced",
        "premium"
      ],
      "title": "GenerationQuality",
      "type": "string"
    },
    "GenerationSettingsOrigin": {
      "enum": [
        "explicit",
        "legacy_default"
      ],
      "title": "GenerationSettingsOrigin",
      "type": "string"
    },
    "NarrationQualityThresholdOverrides": {
      "additionalProperties": false,
      "description": "A project's partial override of the deployment's quality thresholds.\n\nEvery limit is optional: ``None`` means \"use the deployment default\" for\nthat one limit, so a project may relax alignment coverage alone without\nrestating every other number. The warn-only set is overridden separately\non the generation settings, mirroring the validation-code overrides.",
      "properties": {
        "max_clipping_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Clipping Ratio"
        },
        "max_internal_silence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Internal Silence"
        },
        "max_leading_silence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Leading Silence"
        },
        "max_trailing_silence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Trailing Silence"
        },
        "max_wpm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wpm"
        },
        "min_alignment_coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Alignment Coverage"
        },
        "min_wpm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Wpm"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "NarrationQualityThresholdOverrides",
      "type": "object"
    },
    "ShotPacing": {
      "description": "How long an edited shot should typically run.\n\nA preset is a creative preference the Storyboard Director plans against;\nthe deterministic retimer remains the timing authority.",
      "enum": [
        "relaxed",
        "normal",
        "fast"
      ],
      "title": "ShotPacing",
      "type": "string"
    },
    "VisualQAThresholdOverrides": {
      "additionalProperties": false,
      "description": "A project's partial override of the deployment's T20 pass thresholds.\n\nEvery score is optional: ``None`` means \"use the deployment default\" for\nthat one threshold, so a project may relax the hero pass score alone\nwithout restating the others. The warn-only set is overridden separately\non the generation settings, mirroring the narration quality overrides.",
      "properties": {
        "hero_pass_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hero Pass Score"
        },
        "normal_pass_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normal Pass Score"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "targeted_repair_floor": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targeted Repair Floor"
        },
        "utility_pass_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Utility Pass Score"
        }
      },
      "title": "VisualQAThresholdOverrides",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The project's persisted generation settings, always fully resolved.",
  "properties": {
    "generation_quality": {
      "$ref": "#/$defs/GenerationQuality",
      "default": "balanced"
    },
    "narration_quality_thresholds": {
      "anyOf": [
        {
          "$ref": "#/$defs/NarrationQualityThresholdOverrides"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "narration_warn_only_quality_codes": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Narration Warn Only Quality Codes"
    },
    "origin": {
      "$ref": "#/$defs/GenerationSettingsOrigin",
      "default": "explicit"
    },
    "premium_fallback_allowed": {
      "default": false,
      "title": "Premium Fallback Allowed",
      "type": "boolean"
    },
    "scene_detection_threshold": {
      "anyOf": [
        {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scene Detection Threshold"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "script_warn_only_validation_codes": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Script Warn Only Validation Codes"
    },
    "settings_version": {
      "const": "generation-settings/1",
      "default": "generation-settings/1",
      "title": "Settings Version",
      "type": "string"
    },
    "shot_pacing": {
      "$ref": "#/$defs/ShotPacing",
      "default": "normal"
    },
    "storyboard_warn_only_validation_codes": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Storyboard Warn Only Validation Codes"
    },
    "visual_qa_thresholds": {
      "anyOf": [
        {
          "$ref": "#/$defs/VisualQAThresholdOverrides"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "visual_qa_warn_only_codes": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visual Qa Warn Only Codes"
    },
    "warn_only_validation_codes": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Warn Only Validation Codes"
    }
  },
  "title": "ProjectGenerationSettings",
  "type": "object"
}
