{
  "$defs": {
    "CostLineItem": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "rate": {
          "$ref": "#/$defs/PricingRate"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/UsageQuantity"
        }
      },
      "required": [
        "usage",
        "rate",
        "amount"
      ],
      "title": "CostLineItem",
      "type": "object"
    },
    "PricingRate": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "effective_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective End"
        },
        "effective_start": {
          "format": "date-time",
          "title": "Effective Start",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "pricing_version_id": {
          "format": "uuid",
          "title": "Pricing Version Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_reference": {
          "title": "Source Reference",
          "type": "string"
        },
        "unit_price": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Unit Price"
        },
        "unit_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Unit Size"
        },
        "usage_unit": {
          "$ref": "#/$defs/UsageUnit"
        },
        "verification_date": {
          "format": "date",
          "title": "Verification Date",
          "type": "string"
        }
      },
      "required": [
        "pricing_version_id",
        "provider",
        "model",
        "operation",
        "usage_unit",
        "unit_size",
        "unit_price",
        "currency",
        "effective_start",
        "source_reference",
        "verification_date"
      ],
      "title": "PricingRate",
      "type": "object"
    },
    "UsageQuantity": {
      "additionalProperties": false,
      "properties": {
        "estimation_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimation Method"
        },
        "provider_reported": {
          "default": false,
          "title": "Provider Reported",
          "type": "boolean"
        },
        "quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Field"
        },
        "unit": {
          "$ref": "#/$defs/UsageUnit"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "unit",
        "quantity"
      ],
      "title": "UsageQuantity",
      "type": "object"
    },
    "UsageUnit": {
      "enum": [
        "INPUT_TOKEN",
        "OUTPUT_TOKEN",
        "CACHED_INPUT_TOKEN",
        "AUDIO_INPUT_SECOND",
        "AUDIO_OUTPUT_SECOND",
        "IMAGE_INPUT",
        "IMAGE_OUTPUT",
        "VIDEO_OUTPUT_SECOND",
        "REQUEST",
        "STORAGE_BYTE",
        "COMPUTE_SECOND"
      ],
      "title": "UsageUnit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_cost": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actual Cost"
    },
    "currency": {
      "title": "Currency",
      "type": "string"
    },
    "estimated_cost": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Estimated Cost"
    },
    "line_items": {
      "items": {
        "$ref": "#/$defs/CostLineItem"
      },
      "title": "Line Items",
      "type": "array"
    },
    "pricing_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pricing Version Id"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "line_items",
    "estimated_cost",
    "currency",
    "pricing_version_id"
  ],
  "title": "CostEstimate",
  "type": "object"
}
