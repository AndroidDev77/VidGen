{
  "$defs": {
    "FailureClass": {
      "enum": [
        "transient",
        "permanent",
        "validation",
        "quota",
        "provider",
        "cancelled"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "WorkflowFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "error_class": {
          "$ref": "#/$defs/FailureClass"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "error_class",
        "code",
        "message",
        "retryable"
      ],
      "title": "WorkflowFailure",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cancelled": {
      "default": false,
      "title": "Cancelled",
      "type": "boolean"
    },
    "completed_stages": {
      "items": {
        "type": "string"
      },
      "title": "Completed Stages",
      "type": "array"
    },
    "entry_stage": {
      "default": "upload",
      "maxLength": 64,
      "title": "Entry Stage",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generation_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Run Id"
    },
    "next_actions": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Next Actions",
      "type": "array"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "waiting_reason": {
      "default": "",
      "maxLength": 128,
      "title": "Waiting Reason",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "status"
  ],
  "title": "ProjectWorkflowState",
  "type": "object"
}
