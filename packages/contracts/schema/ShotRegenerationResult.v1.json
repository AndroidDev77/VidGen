{
  "$defs": {
    "InvalidationEntry": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 255,
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "maxLength": 128,
          "title": "Reason",
          "type": "string"
        },
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_type": {
          "maxLength": 64,
          "title": "Resource Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "resource_id",
        "label",
        "reason"
      ],
      "title": "InvalidationEntry",
      "type": "object"
    },
    "InvalidationSet": {
      "additionalProperties": false,
      "description": "The exact downstream lineage a mutation will mark stale.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/InvalidationEntry"
          },
          "maxItems": 512,
          "title": "Entries",
          "type": "array"
        },
        "requires_confirmation": {
          "default": false,
          "title": "Requires Confirmation",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "InvalidationSet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What regenerating one shot actually created.\n\n``child_workflow_id`` is deliberately optional and deliberately empty until\nthe dispatcher has started the replacement child: before T18b this field\ncarried a workflow ID that had been *calculated* and never started, which is\nexactly the class of untruth T18b removes. ``command_id`` is what the caller\npolls in the meantime, and it always exists.",
  "properties": {
    "child_workflow_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Child Workflow Id"
    },
    "command_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Id"
    },
    "command_status": {
      "anyOf": [
        {
          "maxLength": 32,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Status"
    },
    "invalidation": {
      "$ref": "#/$defs/InvalidationSet"
    },
    "new_identity_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "New Identity Hash",
      "type": "string"
    },
    "preserved_attempt_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Preserved Attempt Ids",
      "type": "array"
    },
    "previous_identity_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Identity Hash"
    },
    "regeneration_sequence": {
      "default": 0,
      "minimum": 0,
      "title": "Regeneration Sequence",
      "type": "integer"
    },
    "row_version": {
      "minimum": 1,
      "title": "Row Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shot_id": {
      "format": "uuid",
      "title": "Shot Id",
      "type": "string"
    }
  },
  "required": [
    "shot_id",
    "new_identity_hash",
    "invalidation",
    "row_version"
  ],
  "title": "ShotRegenerationResult",
  "type": "object"
}
