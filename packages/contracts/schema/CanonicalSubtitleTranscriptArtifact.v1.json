{
  "$defs": {
    "SubtitleCandidate": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "download_count": {
          "default": 0,
          "minimum": 0,
          "title": "Download Count",
          "type": "integer"
        },
        "file_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Name"
        },
        "forced": {
          "default": false,
          "title": "Forced",
          "type": "boolean"
        },
        "fps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps"
        },
        "hearing_impaired": {
          "default": false,
          "title": "Hearing Impaired",
          "type": "boolean"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "provider_file_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider File Id"
        },
        "provider_subtitle_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Subtitle Id"
        },
        "release_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Name"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "embedded",
            "sidecar",
            "provider"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "stream_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Index"
        },
        "subtitle_format": {
          "title": "Subtitle Format",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "source_type",
        "provider",
        "subtitle_format"
      ],
      "title": "SubtitleCandidate",
      "type": "object"
    },
    "SubtitleQuality": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "cue_count": {
          "minimum": 0,
          "title": "Cue Count",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "sync_correlation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sync Correlation"
        },
        "sync_offset_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sync Offset Seconds"
        },
        "timeline_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Timeline Coverage",
          "type": "number"
        },
        "voiced_coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voiced Coverage"
        }
      },
      "required": [
        "candidate_id",
        "score",
        "cue_count",
        "timeline_coverage",
        "passed"
      ],
      "title": "SubtitleQuality",
      "type": "object"
    },
    "TimeInterval": {
      "additionalProperties": false,
      "properties": {
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        }
      },
      "required": [
        "start_seconds",
        "end_seconds"
      ],
      "title": "TimeInterval",
      "type": "object"
    },
    "TranscriptCoverage": {
      "additionalProperties": false,
      "properties": {
        "covered_voiced_seconds": {
          "minimum": 0,
          "title": "Covered Voiced Seconds",
          "type": "number"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ratio",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "uncovered_intervals": {
          "items": {
            "$ref": "#/$defs/TimeInterval"
          },
          "title": "Uncovered Intervals",
          "type": "array"
        },
        "voiced_seconds": {
          "minimum": 0,
          "title": "Voiced Seconds",
          "type": "number"
        }
      },
      "required": [
        "voiced_seconds",
        "covered_voiced_seconds",
        "ratio",
        "passed"
      ],
      "title": "TranscriptCoverage",
      "type": "object"
    },
    "TranscriptSegment": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "source_chunk_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Chunk Ids",
          "type": "array"
        },
        "speaker_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Label"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/TranscriptWord"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "sequence",
        "start_seconds",
        "end_seconds",
        "text",
        "source_chunk_ids"
      ],
      "title": "TranscriptSegment",
      "type": "object"
    },
    "TranscriptWord": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "end_seconds": {
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "start_seconds",
        "end_seconds"
      ],
      "title": "TranscriptWord",
      "type": "object"
    },
    "TranscriptionWarning": {
      "additionalProperties": false,
      "properties": {
        "chunk_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Sequence"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "TranscriptionWarning",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/SubtitleCandidate"
    },
    "coverage": {
      "$ref": "#/$defs/TranscriptCoverage"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "quality": {
      "$ref": "#/$defs/SubtitleQuality"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/TranscriptSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "source_subtitle_asset_id": {
      "format": "uuid",
      "title": "Source Subtitle Asset Id",
      "type": "string"
    },
    "source_video_id": {
      "format": "uuid",
      "title": "Source Video Id",
      "type": "string"
    },
    "subtitle_run_id": {
      "format": "uuid",
      "title": "Subtitle Run Id",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "transcript_id": {
      "format": "uuid",
      "title": "Transcript Id",
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/TranscriptionWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "subtitle_run_id",
    "transcript_id",
    "source_video_id",
    "source_subtitle_asset_id",
    "text",
    "segments",
    "coverage",
    "candidate",
    "quality"
  ],
  "title": "CanonicalSubtitleTranscriptArtifact",
  "type": "object"
}
