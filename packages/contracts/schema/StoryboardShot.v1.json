{
  "$defs": {
    "ActionPlan": {
      "additionalProperties": false,
      "properties": {
        "beat_intent": {
          "enum": [
            "establish",
            "react",
            "reveal",
            "punchline",
            "continue",
            "insert"
          ],
          "title": "Beat Intent",
          "type": "string"
        },
        "prop_references": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Prop References",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "secondary_action": {
          "default": "",
          "maxLength": 1024,
          "title": "Secondary Action",
          "type": "string"
        },
        "staging_note": {
          "default": "",
          "maxLength": 1024,
          "title": "Staging Note",
          "type": "string"
        },
        "subject_action": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Subject Action",
          "type": "string"
        }
      },
      "required": [
        "subject_action",
        "beat_intent"
      ],
      "title": "ActionPlan",
      "type": "object"
    },
    "CameraPlan": {
      "additionalProperties": false,
      "properties": {
        "angle": {
          "enum": [
            "eye_level",
            "low_angle",
            "high_angle",
            "overhead",
            "dutch",
            "over_the_shoulder",
            "point_of_view"
          ],
          "title": "Angle",
          "type": "string"
        },
        "framing": {
          "enum": [
            "extreme_wide",
            "wide",
            "medium_wide",
            "medium",
            "medium_close",
            "close_up",
            "extreme_close_up",
            "insert"
          ],
          "title": "Framing",
          "type": "string"
        },
        "lens_note": {
          "default": "",
          "maxLength": 512,
          "title": "Lens Note",
          "type": "string"
        },
        "movement": {
          "enum": [
            "static",
            "pan_left",
            "pan_right",
            "tilt_up",
            "tilt_down",
            "dolly_in",
            "dolly_out",
            "tracking",
            "crane",
            "handheld",
            "zoom_in",
            "zoom_out"
          ],
          "title": "Movement",
          "type": "string"
        },
        "movement_intensity": {
          "default": "subtle",
          "enum": [
            "none",
            "subtle",
            "moderate",
            "strong"
          ],
          "title": "Movement Intensity",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "framing",
        "angle",
        "movement"
      ],
      "title": "CameraPlan",
      "type": "object"
    },
    "CharacterAppearanceState": {
      "additionalProperties": false,
      "properties": {
        "appearance_state_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Appearance State Id",
          "type": "string"
        },
        "character_id": {
          "format": "uuid",
          "title": "Character Id",
          "type": "string"
        },
        "emotional_state": {
          "default": "neutral",
          "maxLength": 255,
          "title": "Emotional State",
          "type": "string"
        },
        "injury_state": {
          "default": "none",
          "maxLength": 255,
          "title": "Injury State",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "wardrobe_state": {
          "default": "default",
          "maxLength": 255,
          "title": "Wardrobe State",
          "type": "string"
        }
      },
      "required": [
        "character_id",
        "appearance_state_id"
      ],
      "title": "CharacterAppearanceState",
      "type": "object"
    },
    "ContinuityState": {
      "additionalProperties": false,
      "description": "Structured continuity, never prose alone.",
      "properties": {
        "character_appearance_states": {
          "items": {
            "$ref": "#/$defs/CharacterAppearanceState"
          },
          "title": "Character Appearance States",
          "type": "array"
        },
        "emotional_state": {
          "default": "neutral",
          "maxLength": 255,
          "title": "Emotional State",
          "type": "string"
        },
        "environment_conditions": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Environment Conditions",
          "type": "array"
        },
        "location_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Id"
        },
        "present_character_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Present Character Ids",
          "type": "array"
        },
        "previous_shot_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Shot Id"
        },
        "props": {
          "items": {
            "$ref": "#/$defs/PropState"
          },
          "title": "Props",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "screen_direction": {
          "default": "neutral",
          "enum": [
            "neutral",
            "left_to_right",
            "right_to_left"
          ],
          "title": "Screen Direction",
          "type": "string"
        },
        "sub_location": {
          "default": "",
          "maxLength": 255,
          "title": "Sub Location",
          "type": "string"
        },
        "subject_positions": {
          "items": {
            "$ref": "#/$defs/SubjectPosition"
          },
          "title": "Subject Positions",
          "type": "array"
        },
        "time_of_day": {
          "default": "unspecified",
          "enum": [
            "dawn",
            "morning",
            "midday",
            "afternoon",
            "dusk",
            "night",
            "unspecified"
          ],
          "title": "Time Of Day",
          "type": "string"
        },
        "unresolved_warnings": {
          "items": {
            "$ref": "#/$defs/StructuredNote"
          },
          "title": "Unresolved Warnings",
          "type": "array"
        }
      },
      "title": "ContinuityState",
      "type": "object"
    },
    "PropState": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "default": "",
          "maxLength": 512,
          "title": "Note",
          "type": "string"
        },
        "owner_character_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Character Id"
        },
        "prop_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Prop Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "prop_id"
      ],
      "title": "PropState",
      "type": "object"
    },
    "StoryboardSourceReference": {
      "additionalProperties": false,
      "properties": {
        "end_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Us"
        },
        "note": {
          "default": "",
          "maxLength": 512,
          "title": "Note",
          "type": "string"
        },
        "reference_id": {
          "format": "uuid",
          "title": "Reference Id",
          "type": "string"
        },
        "reference_type": {
          "enum": [
            "evidence_package",
            "scene_evidence",
            "script_segment",
            "narration_segment",
            "narration_asset",
            "plot_beat",
            "character",
            "location",
            "episode_model"
          ],
          "title": "Reference Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Us"
        }
      },
      "required": [
        "reference_type",
        "reference_id"
      ],
      "title": "StoryboardSourceReference",
      "type": "object"
    },
    "StructuredNote": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "StructuredNote",
      "type": "object"
    },
    "SubjectPosition": {
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "format": "uuid",
          "title": "Character Id",
          "type": "string"
        },
        "facing": {
          "default": "neutral",
          "enum": [
            "neutral",
            "left_to_right",
            "right_to_left"
          ],
          "title": "Facing",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "screen_position": {
          "enum": [
            "left",
            "center_left",
            "center",
            "center_right",
            "right",
            "offscreen"
          ],
          "title": "Screen Position",
          "type": "string"
        }
      },
      "required": [
        "character_id",
        "screen_position"
      ],
      "title": "SubjectPosition",
      "type": "object"
    },
    "TransitionPlan": {
      "additionalProperties": false,
      "description": "A transition between two canonical shots.\n\n``handle_us`` is extra *generated* material requested from the visual\nprovider so the transition has something to work with. It is never narration\ncoverage: usable shot intervals stay contiguous and non-overlapping, and the\nhandle is accounted for separately in the timing manifest.",
      "properties": {
        "duration_us": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Us",
          "type": "integer"
        },
        "handle_us": {
          "default": 0,
          "minimum": 0,
          "title": "Handle Us",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "cut",
            "dissolve",
            "fade_in",
            "fade_out",
            "wipe",
            "match_cut",
            "whip_pan"
          ],
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 512,
          "title": "Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "TransitionPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One canonical, fully timed shot.",
  "properties": {
    "action": {
      "$ref": "#/$defs/ActionPlan"
    },
    "camera": {
      "$ref": "#/$defs/CameraPlan"
    },
    "capability_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Capability Hash",
      "type": "string"
    },
    "capability_profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Capability Profile Id",
      "type": "string"
    },
    "character_reference_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Character Reference Ids",
      "type": "array"
    },
    "clause_label": {
      "default": "",
      "maxLength": 255,
      "title": "Clause Label",
      "type": "string"
    },
    "end_us": {
      "exclusiveMinimum": 0,
      "title": "End Us",
      "type": "integer"
    },
    "evidence_references": {
      "items": {
        "$ref": "#/$defs/StoryboardSourceReference"
      },
      "title": "Evidence References",
      "type": "array"
    },
    "expected_outgoing_continuity": {
      "$ref": "#/$defs/ContinuityState"
    },
    "global_end_us": {
      "exclusiveMinimum": 0,
      "title": "Global End Us",
      "type": "integer"
    },
    "global_sequence": {
      "minimum": 0,
      "title": "Global Sequence",
      "type": "integer"
    },
    "global_start_us": {
      "minimum": 0,
      "title": "Global Start Us",
      "type": "integer"
    },
    "incoming_continuity": {
      "$ref": "#/$defs/ContinuityState"
    },
    "location_reference_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location Reference Id"
    },
    "narration_segment_id": {
      "format": "uuid",
      "title": "Narration Segment Id",
      "type": "string"
    },
    "prop_references": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Prop References",
      "type": "array"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
    "requested_generation_duration_us": {
      "exclusiveMinimum": 0,
      "title": "Requested Generation Duration Us",
      "type": "integer"
    },
    "requires_last_frame": {
      "default": false,
      "title": "Requires Last Frame",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "script_segment_id": {
      "format": "uuid",
      "title": "Script Segment Id",
      "type": "string"
    },
    "segment_id": {
      "format": "uuid",
      "title": "Segment Id",
      "type": "string"
    },
    "segment_sequence": {
      "minimum": 0,
      "title": "Segment Sequence",
      "type": "integer"
    },
    "shot_id": {
      "format": "uuid",
      "title": "Shot Id",
      "type": "string"
    },
    "start_us": {
      "minimum": 0,
      "title": "Start Us",
      "type": "integer"
    },
    "storyboard_run_id": {
      "format": "uuid",
      "title": "Storyboard Run Id",
      "type": "string"
    },
    "transition_handle_us": {
      "default": 0,
      "minimum": 0,
      "title": "Transition Handle Us",
      "type": "integer"
    },
    "transition_in": {
      "$ref": "#/$defs/TransitionPlan"
    },
    "transition_out": {
      "$ref": "#/$defs/TransitionPlan"
    },
    "trim_end_us": {
      "default": 0,
      "minimum": 0,
      "title": "Trim End Us",
      "type": "integer"
    },
    "trim_start_us": {
      "default": 0,
      "minimum": 0,
      "title": "Trim Start Us",
      "type": "integer"
    },
    "usable_duration_us": {
      "exclusiveMinimum": 0,
      "title": "Usable Duration Us",
      "type": "integer"
    },
    "visual_objective": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Visual Objective",
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/StructuredNote"
      },
      "title": "Warnings",
      "type": "array"
    },
    "word_end_index": {
      "exclusiveMinimum": 0,
      "title": "Word End Index",
      "type": "integer"
    },
    "word_start_index": {
      "minimum": 0,
      "title": "Word Start Index",
      "type": "integer"
    }
  },
  "required": [
    "shot_id",
    "storyboard_run_id",
    "segment_id",
    "global_sequence",
    "segment_sequence",
    "script_segment_id",
    "narration_segment_id",
    "start_us",
    "end_us",
    "global_start_us",
    "global_end_us",
    "usable_duration_us",
    "requested_generation_duration_us",
    "word_start_index",
    "word_end_index",
    "visual_objective",
    "camera",
    "action",
    "transition_in",
    "transition_out",
    "incoming_continuity",
    "expected_outgoing_continuity",
    "capability_profile_id",
    "capability_hash"
  ],
  "title": "StoryboardShot",
  "type": "object"
}
