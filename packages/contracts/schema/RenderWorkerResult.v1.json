{
  "$defs": {
    "RenderExecutionStatus": {
      "description": "The durable render-job state machine T17b advances.\n\nThe values are the persisted ``render_jobs.status`` values, so a projection\nnever has to translate between a workflow status and a database status.\n``QUEUED`` is the state T18 and the CLI create; every other value is written\nby the executor.",
      "enum": [
        "render_queued",
        "render_claiming",
        "render_preparing",
        "render_manifest_ready",
        "render_rendering",
        "render_verifying",
        "render_persisting",
        "render_complete",
        "render_failed",
        "render_cancelled"
      ],
      "title": "RenderExecutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The compact record the worker prints and turns into a process exit code.",
  "properties": {
    "exit_code": {
      "maximum": 125,
      "minimum": 0,
      "title": "Exit Code",
      "type": "integer"
    },
    "failure_classification": {
      "anyOf": [
        {
          "maxLength": 32,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Classification"
    },
    "failure_code": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "final_video_asset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Video Asset Id"
    },
    "measured_duration_us": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measured Duration Us"
    },
    "output_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Sha256"
    },
    "render_job_id": {
      "format": "uuid",
      "title": "Render Job Id",
      "type": "string"
    },
    "reused": {
      "default": false,
      "title": "Reused",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RenderExecutionStatus"
    }
  },
  "required": [
    "render_job_id",
    "status",
    "exit_code"
  ],
  "title": "RenderWorkerResult",
  "type": "object"
}
