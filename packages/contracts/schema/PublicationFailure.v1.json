{
  "$defs": {
    "PublicationFailureCode": {
      "description": "The T23 failure classification for every YouTube operation.\n\nEvery member maps to exactly one operator action, which is why there is no\ngeneric ``ERROR``.",
      "enum": [
        "NO_ELIGIBLE_RENDER",
        "RENDER_NOT_SELECTED",
        "RENDER_NOT_APPROVED",
        "COMPLETION_GATE_NOT_PASSED",
        "STALE_RENDER",
        "UNRESOLVED_HUMAN_REVIEW",
        "CROSS_PROJECT_REFERENCE",
        "MISSING_FINAL_ASSET",
        "MISSING_CAPTION_ASSET",
        "INVALID_THUMBNAIL_ASSET",
        "INVALID_METADATA",
        "INVALID_SCHEDULE",
        "CONNECTION_NOT_OWNED",
        "AUTHENTICATION_REQUIRED",
        "INVALID_GRANT",
        "INSUFFICIENT_SCOPE",
        "CHANNEL_MISMATCH",
        "QUOTA_EXCEEDED",
        "UPLOAD_LIMIT_EXCEEDED",
        "RATE_LIMITED",
        "RETRYABLE_SERVER_ERROR",
        "EXPIRED_RESUMABLE_SESSION",
        "AMBIGUOUS_COMPLETION",
        "PROCESSING_FAILED",
        "CAPTION_CONFLICT",
        "THUMBNAIL_NOT_PERMITTED",
        "PRIVACY_RESTRICTED",
        "PROVIDER_REJECTED",
        "CANCELLED"
      ],
      "title": "PublicationFailureCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A structured, renderable publication failure. Never carries a secret.",
  "properties": {
    "code": {
      "$ref": "#/$defs/PublicationFailureCode"
    },
    "http_status": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Http Status"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "provider_reason": {
      "default": "",
      "maxLength": 128,
      "title": "Provider Reason",
      "type": "string"
    },
    "reference_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Id"
    },
    "remediation": {
      "default": "",
      "maxLength": 500,
      "title": "Remediation",
      "type": "string"
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "maxLength": 500,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "code",
    "summary"
  ],
  "title": "PublicationFailure",
  "type": "object"
}
