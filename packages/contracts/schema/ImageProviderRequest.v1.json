{
  "$defs": {
    "ImageFormat": {
      "enum": [
        "png",
        "jpeg",
        "webp"
      ],
      "title": "ImageFormat",
      "type": "string"
    },
    "ImageQuality": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ImageQuality",
      "type": "string"
    },
    "ImageReferenceBinding": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_role": {
          "enum": [
            "source",
            "style",
            "character",
            "location",
            "approved"
          ],
          "title": "Semantic Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "semantic_role",
        "order",
        "media_type"
      ],
      "title": "ImageReferenceBinding",
      "type": "object"
    },
    "KeyframeRole": {
      "enum": [
        "FIRST_FRAME",
        "LAST_FRAME"
      ],
      "title": "KeyframeRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "application_idempotency_key": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Application Idempotency Key",
      "type": "string"
    },
    "attempt_number": {
      "exclusiveMinimum": 0,
      "title": "Attempt Number",
      "type": "integer"
    },
    "background": {
      "default": "opaque",
      "enum": [
        "opaque",
        "transparent"
      ],
      "title": "Background",
      "type": "string"
    },
    "compiled_prompt": {
      "minLength": 1,
      "title": "Compiled Prompt",
      "type": "string"
    },
    "height": {
      "exclusiveMinimum": 0,
      "title": "Height",
      "type": "integer"
    },
    "image_generation_run_id": {
      "format": "uuid",
      "title": "Image Generation Run Id",
      "type": "string"
    },
    "keyframe_role": {
      "$ref": "#/$defs/KeyframeRole"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "output_format": {
      "$ref": "#/$defs/ImageFormat",
      "default": "png"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "provider_configuration_version": {
      "title": "Provider Configuration Version",
      "type": "string"
    },
    "provider_options": {
      "additionalProperties": true,
      "title": "Provider Options",
      "type": "object"
    },
    "quality": {
      "$ref": "#/$defs/ImageQuality",
      "default": "medium"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/ImageReferenceBinding"
      },
      "title": "References",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shot_id": {
      "format": "uuid",
      "title": "Shot Id",
      "type": "string"
    },
    "shot_sequence": {
      "minimum": 0,
      "title": "Shot Sequence",
      "type": "integer"
    },
    "storyboard_id": {
      "format": "uuid",
      "title": "Storyboard Id",
      "type": "string"
    },
    "storyboard_version": {
      "exclusiveMinimum": 0,
      "title": "Storyboard Version",
      "type": "integer"
    },
    "trace_context": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Trace Context",
      "type": "object"
    },
    "width": {
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "application_idempotency_key",
    "project_id",
    "image_generation_run_id",
    "storyboard_id",
    "storyboard_version",
    "shot_id",
    "shot_sequence",
    "keyframe_role",
    "compiled_prompt",
    "model",
    "width",
    "height",
    "attempt_number",
    "provider_configuration_version"
  ],
  "title": "ImageProviderRequest",
  "type": "object"
}
