{
  "$defs": {
    "FailureClass": {
      "enum": [
        "TRANSPORT",
        "TIMEOUT",
        "RATE_LIMIT",
        "AUTHENTICATION",
        "AUTHORIZATION",
        "INVALID_REQUEST",
        "PROVIDER_REJECTED",
        "CONTENT_FILTER",
        "CONTRACT_VALIDATION",
        "QUALITY_FAILURE",
        "BUDGET_EXCEEDED",
        "CANCELLED",
        "DATABASE",
        "STORAGE",
        "TEMPORAL",
        "INTERNAL",
        "UNKNOWN"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "FailureClassification": {
      "additionalProperties": false,
      "properties": {
        "diagnostic_metadata": {
          "additionalProperties": true,
          "title": "Diagnostic Metadata",
          "type": "object"
        },
        "error_code": {
          "title": "Error Code",
          "type": "string"
        },
        "failure_class": {
          "$ref": "#/$defs/FailureClass"
        },
        "provider_error_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Error Type"
        },
        "provider_http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Http Status"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "sanitized_message": {
          "title": "Sanitized Message",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "failure_class",
        "error_code",
        "retryable",
        "sanitized_message"
      ],
      "title": "FailureClassification",
      "type": "object"
    },
    "UsageQuantity": {
      "additionalProperties": false,
      "properties": {
        "estimation_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimation Method"
        },
        "provider_reported": {
          "default": false,
          "title": "Provider Reported",
          "type": "boolean"
        },
        "quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Field"
        },
        "unit": {
          "$ref": "#/$defs/UsageUnit"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "unit",
        "quantity"
      ],
      "title": "UsageQuantity",
      "type": "object"
    },
    "UsageUnit": {
      "enum": [
        "INPUT_TOKEN",
        "OUTPUT_TOKEN",
        "CACHED_INPUT_TOKEN",
        "AUDIO_INPUT_SECOND",
        "AUDIO_OUTPUT_SECOND",
        "IMAGE_INPUT",
        "IMAGE_OUTPUT",
        "VIDEO_OUTPUT_SECOND",
        "REQUEST",
        "STORAGE_BYTE",
        "COMPUTE_SECOND"
      ],
      "title": "UsageUnit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "format": "uuid",
      "title": "Attempt Id",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "failure": {
      "$ref": "#/$defs/FailureClassification"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "usage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UsageQuantity"
      },
      "title": "Usage",
      "type": "array"
    }
  },
  "required": [
    "attempt_id",
    "completed_at",
    "latency_ms",
    "failure"
  ],
  "title": "ProviderAttemptFailed",
  "type": "object"
}
