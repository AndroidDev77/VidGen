{
  "$defs": {
    "RepairDiagnosticCode": {
      "description": "The bounded distinctions the classifier must be able to make.\n\nAdding a member is a contract version change: the planner, the policy and\nthe dashboard all switch on this enum.",
      "enum": [
        "wrong_character_identity",
        "wrong_character_count",
        "wrong_location",
        "wrong_wardrobe_or_state",
        "missing_or_incorrect_action",
        "weak_motion",
        "composition_failure",
        "anatomy_or_artifact_failure",
        "continuity_failure",
        "style_mismatch",
        "prompt_overconstraint",
        "prompt_ambiguity",
        "reference_conflict",
        "provider_safety_rejection",
        "provider_timeout_or_service_failure",
        "unsupported_provider_capability",
        "impossible_duration_or_motion",
        "corrupt_or_incomplete_media"
      ],
      "title": "RepairDiagnosticCode",
      "type": "string"
    },
    "VisualQABoundingBox": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "VisualQABoundingBox",
      "type": "object"
    },
    "VisualQARepairCode": {
      "description": "The bounded taxonomy T21 consumes. Adding a member is a version change.",
      "enum": [
        "WRONG_CHARACTER_IDENTITY",
        "MISSING_PRIMARY_CHARACTER",
        "EXTRA_CHARACTER",
        "WRONG_CHARACTER_COUNT",
        "WRONG_WARDROBE",
        "WRONG_CHARACTER_STATE",
        "WRONG_LOCATION",
        "WRONG_LOCATION_STATE",
        "MISSING_REQUIRED_PROP",
        "WRONG_PROP_OWNERSHIP",
        "MISSING_MANDATORY_ACTION",
        "WRONG_ACTION",
        "INSUFFICIENT_MOTION",
        "EXCESSIVE_MOTION",
        "CAMERA_PLAN_MISMATCH",
        "COMPOSITION_MISMATCH",
        "SCREEN_DIRECTION_CONTRADICTION",
        "FACE_BREAKAGE",
        "ANATOMY_BREAKAGE",
        "UNINTENDED_TEXT",
        "STYLE_DRIFT",
        "CONTINUITY_BREAK",
        "BLACK_VIDEO",
        "EXCESSIVE_FREEZE",
        "EXCESSIVE_FLICKER",
        "DURATION_MISMATCH",
        "DECODE_FAILURE",
        "PROMPT_TOO_COMPLEX",
        "TOO_MANY_CHARACTERS",
        "TOO_MANY_REFERENCES",
        "AMBIGUOUS_VISUAL_EVIDENCE",
        "HUMAN_REVIEW_REQUIRED"
      ],
      "title": "VisualQARepairCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One structured reason a shot failed, tied to the T20 evidence for it.",
  "properties": {
    "bounding_box": {
      "anyOf": [
        {
          "$ref": "#/$defs/VisualQABoundingBox"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "code": {
      "$ref": "#/$defs/RepairDiagnosticCode"
    },
    "confidence": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "dimension": {
      "default": "",
      "maxLength": 64,
      "title": "Dimension",
      "type": "string"
    },
    "evidence_timestamp_us": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Timestamp Us"
    },
    "repair_codes": {
      "items": {
        "$ref": "#/$defs/VisualQARepairCode"
      },
      "maxItems": 8,
      "title": "Repair Codes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "enum": [
        "warning",
        "hard_failure"
      ],
      "title": "Severity",
      "type": "string"
    },
    "source_finding_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Source Finding Ids",
      "type": "array"
    },
    "summary": {
      "default": "",
      "maxLength": 500,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "code",
    "severity"
  ],
  "title": "RepairDiagnostic",
  "type": "object"
}
