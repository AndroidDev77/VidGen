{
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "identity_version_id": {
      "format": "uuid",
      "title": "Identity Version Id",
      "type": "string"
    },
    "location_id": {
      "format": "uuid",
      "title": "Location Id",
      "type": "string"
    },
    "ordered_asset_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Ordered Asset Ids",
      "type": "array"
    },
    "primary_asset_id": {
      "format": "uuid",
      "title": "Primary Asset Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "reference_identity": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Reference Identity",
      "type": "string"
    },
