{
  "$defs": {
    "CharacterAppearanceState": {
      "additionalProperties": false,
      "properties": {
        "action_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action State"
        },
        "carried_props": {
          "items": {
            "type": "string"
          },
          "title": "Carried Props",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "dirt_or_damage": {
          "items": {
            "type": "string"
          },
          "title": "Dirt Or Damage",
          "type": "array"
        },
        "disguise": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disguise"
        },
        "emotional_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emotional State"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          },
          "title": "Evidence",
          "type": "array"
        },
        "hairstyle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hairstyle"
        },
        "injuries": {
          "items": {
            "type": "string"
          },
          "title": "Injuries",
          "type": "array"
        },
        "interval": {
          "$ref": "#/$defs/Interval"
        },
        "prop_ownership": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prop Ownership",
          "type": "object"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unresolved_conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Conflicts",
          "type": "array"
        },
        "wardrobe": {
          "items": {
            "type": "string"
          },
          "title": "Wardrobe",
          "type": "array"
        }
      },
      "required": [
        "interval",
        "confidence"
      ],
      "title": "CharacterAppearanceState",
      "type": "object"
    },
    "EvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "scene_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_timestamp_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Timestamp Ms"
        }
      },
      "required": [
        "evidence_id"
      ],
      "title": "EvidenceLink",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "end_sequence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Sequence"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_sequence": {
          "minimum": 0,
          "title": "Start Sequence",
          "type": "integer"
        }
      },
      "required": [
        "start_sequence"
      ],
      "title": "Interval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "character_id": {
      "format": "uuid",
      "title": "Character Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "identity_version_id": {
      "format": "uuid",
      "title": "Identity Version Id",
      "type": "string"
    },
    "resolver_version": {
      "title": "Resolver Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shot_id": {
      "format": "uuid",
      "title": "Shot Id",
      "type": "string"
    },
    "snapshot_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshot Hash",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/CharacterAppearanceState"
    }
  },
  "required": [
    "id",
    "shot_id",
    "character_id",
    "identity_version_id",
    "state",
    "snapshot_hash",
    "resolver_version"
  ],
  "title": "CharacterStateSnapshot",
  "type": "object"
}
