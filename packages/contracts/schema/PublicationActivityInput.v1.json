    },
    "publication_run_id": {
      "format": "uuid",
      "title": "Publication Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_context": {
      "additionalProperties": {
        "type": "string"
