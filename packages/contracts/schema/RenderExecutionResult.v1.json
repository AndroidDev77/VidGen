{
  "$defs": {
    "CaptionValidationDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "cue_sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cue Sequence"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "CaptionValidationDiagnostic",
      "type": "object"
    },
    "RenderExecutionStatus": {
      "description": "The durable render-job state machine T17b advances.\n\nThe values are the persisted ``render_jobs.status`` values, so a projection\nnever has to translate between a workflow status and a database status.\n``QUEUED`` is the state T18 and the CLI create; every other value is written\nby the executor.",
      "enum": [
        "render_queued",
        "render_claiming",
        "render_preparing",
        "render_manifest_ready",
        "render_rendering",
        "render_verifying",
        "render_persisting",
        "render_complete",
        "render_failed",
        "render_cancelled"
      ],
      "title": "RenderExecutionStatus",
      "type": "string"
    },
    "RenderFailure": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "lineage",
            "validation",
            "transient",
            "cancelled",
            "execution"
          ],
          "title": "Classification",
          "type": "string"
        },
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/CaptionValidationDiagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "classification",
        "code",
        "message",
        "retryable"
      ],
      "title": "RenderFailure",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The canonical outcome of :func:`execute_render_job`.\n\nEvery entry point returns this shape. ``reused`` marks an idempotent\nno-op: the job was already complete, or another worker completed it while\nthis one waited.",
  "properties": {
    "attempt": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "caption_srt_asset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caption Srt Asset Id"
    },
    "caption_webvtt_asset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caption Webvtt Asset Id"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "expected_duration_us": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Duration Us"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/RenderFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ffmpeg_version": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ffmpeg Version"
    },
    "final_video_asset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Video Asset Id"
    },
    "input_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Hash"
    },
    "manifest_asset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Asset Id"
    },
    "measured_duration_us": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measured Duration Us"
    },
    "output_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Sha256"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "render_identity": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Render Identity"
    },
    "render_job_id": {
      "format": "uuid",
      "title": "Render Job Id",
      "type": "string"
    },
    "renderer_version": {
      "anyOf": [
        {
          "maxLength": 32,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Renderer Version"
    },
    "reused": {
      "default": false,
      "title": "Reused",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RenderExecutionStatus"
    },
    "verification_report_asset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Report Asset Id"
    },
    "warning_codes": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Warning Codes",
      "type": "array"
    }
  },
  "required": [
    "render_job_id",
    "project_id",
    "status"
  ],
  "title": "RenderExecutionResult",
  "type": "object"
}
