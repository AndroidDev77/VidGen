{
  "$defs": {
    "ReferenceWorkflowStatus": {
      "enum": [
        "references_queued",
        "references_selecting",
        "references_building",
        "references_generating",
        "references_validating",
        "references_awaiting_approval",
        "references_binding",
        "references_complete",
        "references_failed",
        "references_cancelled"
      ],
      "title": "ReferenceWorkflowStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "affected_shot_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Affected Shot Ids",
      "type": "array"
    },
    "approved_version_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Approved Version Ids",
      "type": "array"
    },
    "cancelled": {
      "default": false,
      "title": "Cancelled",
      "type": "boolean"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "reference_run_id": {
      "format": "uuid",
      "title": "Reference Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReferenceWorkflowStatus"
    }
  },
  "required": [
    "project_id",
    "reference_run_id",
    "status"
  ],
  "title": "ReferenceWorkflowResult",
  "type": "object"
}
