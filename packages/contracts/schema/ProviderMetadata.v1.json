{
  "$defs": {
    "StructuredNote": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "StructuredNote",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_number": {
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "contract_version": {
      "title": "Contract Version",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "provider_request_id": {
      "title": "Provider Request Id",
      "type": "string"
    },
    "redacted_response_metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Redacted Response Metadata",
      "type": "object"
    },
    "validation_status": {
      "default": "pending",
      "enum": [
        "pending",
        "valid",
        "invalid"
      ],
      "title": "Validation Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/StructuredNote"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "provider",
    "model",
    "provider_request_id",
    "attempt_number",
    "prompt_version",
    "contract_version",
    "input_hash"
  ],
  "title": "ProviderMetadata",
  "type": "object"
}
