{
  "$defs": {
    "UsageUnit": {
      "enum": [
        "INPUT_TOKEN",
        "OUTPUT_TOKEN",
        "CACHED_INPUT_TOKEN",
        "AUDIO_INPUT_SECOND",
        "AUDIO_OUTPUT_SECOND",
        "IMAGE_INPUT",
        "IMAGE_OUTPUT",
        "VIDEO_OUTPUT_SECOND",
        "REQUEST",
        "STORAGE_BYTE",
        "COMPUTE_SECOND"
      ],
      "title": "UsageUnit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "estimation_method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimation Method"
    },
    "provider_reported": {
      "default": false,
      "title": "Provider Reported",
      "type": "boolean"
    },
    "quantity": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Quantity"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Field"
    },
    "unit": {
      "$ref": "#/$defs/UsageUnit"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "unit",
    "quantity"
  ],
  "title": "UsageQuantity",
  "type": "object"
}
