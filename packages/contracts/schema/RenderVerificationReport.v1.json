      "title": "Frame Count"
    },
    "frame_rate": {
      "title": "Frame Rate",
      "type": "string"
    },
    "freeze_intervals": {
      "items": {
        "additionalProperties": {
          "type": "integer"
        },
        "type": "object"
      },
      "title": "Freeze Intervals",
      "type": "array"
    },
    "full_decode_ok": {
      "title": "Full Decode Ok",
      "type": "boolean"
    },
    "integrated_lufs": {
      "title": "Integrated Lufs",
      "type": "number"
    },
    "loudness_range": {
      "title": "Loudness Range",
      "type": "number"
    },
    "manifest_asset_id": {
      "format": "uuid",
      "title": "Manifest Asset Id",
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "measured_duration_us": {
      "exclusiveMinimum": 0,
      "title": "Measured Duration Us",
      "type": "integer"
    },
    "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
    },
