      "title": "Schema Version",
      "type": "string"
    },
    "silence_intervals": {
      "items": {
        "additionalProperties": {
          "type": "integer"
        },
        "type": "object"
      },
      "title": "Silence Intervals",
      "type": "array"
    },
    "stream_metadata": {
      "additionalProperties": true,
      "title": "Stream Metadata",
      "type": "object"
    },
