      "maxLength": 256,
      "title": "Ffmpeg Version",
      "type": "string"
    },
    "ffprobe_version": {
      "maxLength": 256,
      "title": "Ffprobe Version",
      "type": "string"
    },
    "final_video_asset_id": {
      "format": "uuid",
      "title": "Final Video Asset Id",
      "type": "string"
    },
