      "pattern": "^[a-f0-9]{64}$",
      "title": "Final Video Hash",
      "type": "string"
    },
    "frame_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
