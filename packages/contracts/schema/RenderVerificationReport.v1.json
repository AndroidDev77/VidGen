      "type": "array"
    },
    "caption_asset_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 2,
      "title": "Caption Asset Ids",
      "type": "array"
    },
    "caption_hashes": {
      "items": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 2,
      "title": "Caption Hashes",
      "type": "array"
    },
    "command_plan_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Command Plan Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "duration_difference_us": {
      "title": "Duration Difference Us",
      "type": "integer"
    },
    "encoder": {
      "maxLength": 128,
      "title": "Encoder",
      "type": "string"
    },
    "expected_duration_us": {
      "exclusiveMinimum": 0,
      "title": "Expected Duration Us",
      "type": "integer"
    },
    "failures": {
      "items": {
        "type": "string"
      },
      "title": "Failures",
      "type": "array"
    },
