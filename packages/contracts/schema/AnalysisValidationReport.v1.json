{
  "$defs": {
    "AnalysisValidationError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "entity_path": {
          "title": "Entity Path",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "invalid_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Value"
        },
        "source_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "entity_path",
        "explanation"
      ],
      "title": "AnalysisValidationError",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "reference_id": {
          "format": "uuid",
          "title": "Reference Id",
          "type": "string"
        },
        "reference_type": {
          "enum": [
            "transcript_segment",
            "speaker_turn",
            "source_scene",
            "frame",
            "contact_sheet",
            "project"
          ],
          "title": "Reference Type",
          "type": "string"
        },
        "scene_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        }
      },
      "required": [
        "reference_type",
        "reference_id"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "StructuredNote": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "StructuredNote",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "errors": {
      "items": {
        "$ref": "#/$defs/AnalysisValidationError"
      },
      "title": "Errors",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/StructuredNote"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "valid"
  ],
  "title": "AnalysisValidationReport",
  "type": "object"
}
