VIDGEN_ENV=local
VIDGEN_DATABASE_URL=postgresql+psycopg://vidgen:vidgen@localhost:5432/vidgen
VIDGEN_REDIS_URL=redis://localhost:6379/0
VIDGEN_BLOB_BACKEND=filesystem
VIDGEN_BLOB_ROOT=.local-data/blobs
# Set VIDGEN_BLOB_BACKEND=azure in a deployed environment. The account is then
# reached over a private endpoint with the workload's managed identity: there is
# no key, connection string or SAS token to configure.
# VIDGEN_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
VIDGEN_BLOB_CONTAINER=assets
VIDGEN_SIGNING_SECRET=local-development-only-change-me
VIDGEN_OPENSUBTITLES_API_KEY=
VIDGEN_OPENSUBTITLES_USERNAME=
VIDGEN_OPENSUBTITLES_PASSWORD=
VIDGEN_SUBTITLE_LANGUAGES=en
VIDGEN_SUBTITLE_SYNC_ENABLED=false
# Leave the provider credentials empty for a fake-provider local pipeline. A
# set credential always wins over the fake provider: the worker prefers OpenAI
# or Runway whenever the matching key is present, even with
# VIDGEN_TEMPORAL_ALLOW_FAKE_PROVIDERS=true, and those calls cost money.
VIDGEN_OPENAI_API_KEY=
VIDGEN_RUNWAY_API_SECRET=
# Used only by scripts/generate_narration.py --provider elevenlabs. The Temporal
# worker's narration stage uses OpenAI or the fake provider.
VIDGEN_ELEVENLABS_API_KEY=
VIDGEN_TRANSCRIPTION_MODEL=whisper-1
VIDGEN_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
VIDGEN_STORYBOARD_MODEL=gpt-5.6
# Configured downstream visual-provider capability profile used to plan T13 timing.
VIDGEN_VISUAL_CAPABILITY_PROFILE=runway-gen4-turbo
VIDGEN_UPLOAD_ROOT=.local-data/uploads
VIDGEN_MAX_UPLOAD_BYTES=10737418240
VIDGEN_ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime
# Set to 1 only for an explicitly disposable database used by migration tests.
VIDGEN_ALLOW_DESTRUCTIVE_MIGRATION_TEST=0
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# --- T18 review UI ---
# Temporal connection for the API's workflow control plane. The fake controller
# keeps local development and the test suites free of a Temporal cluster.
VIDGEN_TEMPORAL_TARGET_HOST=localhost:7233
VIDGEN_TEMPORAL_NAMESPACE=default
# Off by default in code so an unconfigured deployment cannot report workflows
# as running while nothing was started; local development opts in here.
VIDGEN_TEMPORAL_USE_FAKE_WORKFLOW_CONTROLLER=true
# Lets the Temporal worker fall back to the deterministic, credential-free fake
# AI providers when no paid credential is configured. Off by default so an
# unconfigured deployment fails loudly instead of shipping synthetic output.
# Set to true for the full local pipeline with fake providers.
VIDGEN_TEMPORAL_ALLOW_FAKE_PROVIDERS=false
# Provider names as bound into the T16 child-workflow identity, so a T18 shot
# command addresses the real child workflow.
VIDGEN_IMAGE_PROVIDER_NAME=openai
VIDGEN_VIDEO_PROVIDER_NAME=runway
# CORS stays disabled unless this narrow development allowlist is set. Local
# development should prefer the Vite dev proxy over cross-origin requests.
VIDGEN_CORS_ALLOWED_ORIGINS=

# T21 repair and fallback routing. The alternate animation provider is Google
# Veo; the model is pinned by a versioned capability profile rather than named
# at each call site. Set the provider to "none" to disable that route entirely.
# Set to "veo" once the Google credentials below are configured. Left as
# "none", repairs still use the same provider and the free 2.5D fallback.
VIDGEN_REPAIR_ALTERNATE_PROVIDER=none
VIDGEN_REPAIR_MAX_SAME_PROVIDER_REPAIRS=2
VIDGEN_REPAIR_ALLOW_PARALLAX_FALLBACK=true
# Optional per-shot repair spend limit on top of the project's T23 hard cap.
# Leave unset to let the project budget be the only money limit.
# VIDGEN_REPAIR_PER_SHOT_COST_LIMIT=1.50
# VIDGEN_VEO_MODEL=veo-3.1-fast-generate-001
VIDGEN_VEO_LOCATION=us-central1
# Google credentials are only needed for a real Veo call; fake mode needs none.
# VIDGEN_GOOGLE_CLOUD_PROJECT=
# VIDGEN_GOOGLE_ACCESS_TOKEN=

# --- T24 deployment (set by the Container App, not needed locally) ---
# Application Insights ingestion target, resolved from Key Vault by the
# workload's managed identity. Carries an instrumentation key, so it is a secret.
# VIDGEN_APPLICATIONINSIGHTS_CONNECTION_STRING=
# Temporal Cloud connection read by workers/temporal_worker/main.py.
# TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=<namespace>.<account>
# TEMPORAL_TASK_QUEUE=vidgen-projects
# TEMPORAL_TLS_ENABLED=true
# TEMPORAL_API_KEY=
# TEMPORAL_GRACEFUL_SHUTDOWN_SECONDS=45
# TEMPORAL_MAX_CONCURRENT_ACTIVITIES=4
# TEMPORAL_MAX_CONCURRENT_WORKFLOW_TASKS=50
