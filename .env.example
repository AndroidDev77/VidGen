VIDGEN_ENV=local
VIDGEN_DATABASE_URL=postgresql+psycopg://vidgen:vidgen@localhost:5432/vidgen
VIDGEN_REDIS_URL=redis://localhost:6379/0
VIDGEN_BLOB_BACKEND=filesystem
VIDGEN_BLOB_ROOT=.local-data/blobs
VIDGEN_SIGNING_SECRET=local-development-only-change-me
VIDGEN_OPENSUBTITLES_API_KEY=
VIDGEN_OPENSUBTITLES_USERNAME=
VIDGEN_OPENSUBTITLES_PASSWORD=
VIDGEN_SUBTITLE_LANGUAGES=en
VIDGEN_SUBTITLE_SYNC_ENABLED=false
VIDGEN_OPENAI_API_KEY=
VIDGEN_TRANSCRIPTION_MODEL=whisper-1
VIDGEN_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
VIDGEN_UPLOAD_ROOT=.local-data/uploads
VIDGEN_MAX_UPLOAD_BYTES=10737418240
VIDGEN_ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime
# Set to 1 only for an explicitly disposable database used by migration tests.
VIDGEN_ALLOW_DESTRUCTIVE_MIGRATION_TEST=0
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
