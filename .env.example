VIDGEN_ENV=local
VIDGEN_DATABASE_URL=postgresql+psycopg://vidgen:vidgen@localhost:5432/vidgen
VIDGEN_REDIS_URL=redis://localhost:6379/0
VIDGEN_BLOB_BACKEND=filesystem
VIDGEN_BLOB_ROOT=.local-data/blobs
VIDGEN_SIGNING_SECRET=local-development-only-change-me
VIDGEN_OPENSUBTITLES_API_KEY=
VIDGEN_OPENSUBTITLES_USERNAME=
VIDGEN_OPENSUBTITLES_PASSWORD=
VIDGEN_SUBTITLE_LANGUAGES=en
VIDGEN_SUBTITLE_SYNC_ENABLED=false
VIDGEN_OPENAI_API_KEY=
VIDGEN_RUNWAY_API_SECRET=
VIDGEN_TRANSCRIPTION_MODEL=whisper-1
VIDGEN_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
VIDGEN_STORYBOARD_MODEL=gpt-5.6
# Configured downstream visual-provider capability profile used to plan T13 timing.
VIDGEN_VISUAL_CAPABILITY_PROFILE=runway-gen4-turbo
VIDGEN_UPLOAD_ROOT=.local-data/uploads
VIDGEN_MAX_UPLOAD_BYTES=10737418240
VIDGEN_ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime
# Set to 1 only for an explicitly disposable database used by migration tests.
VIDGEN_ALLOW_DESTRUCTIVE_MIGRATION_TEST=0
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# --- T18 review UI ---
# Temporal connection for the API's workflow control plane. The fake controller
# keeps local development and the test suites free of a Temporal cluster.
VIDGEN_TEMPORAL_TARGET_HOST=localhost:7233
VIDGEN_TEMPORAL_NAMESPACE=default
# Off by default in code so an unconfigured deployment cannot report workflows
# as running while nothing was started; local development opts in here.
VIDGEN_TEMPORAL_USE_FAKE_WORKFLOW_CONTROLLER=true
# Provider names as bound into the T16 child-workflow identity, so a T18 shot
# command addresses the real child workflow.
VIDGEN_IMAGE_PROVIDER_NAME=openai
VIDGEN_VIDEO_PROVIDER_NAME=runway
# CORS stays disabled unless this narrow development allowlist is set. Local
# development should prefer the Vite dev proxy over cross-origin requests.
VIDGEN_CORS_ALLOWED_ORIGINS=
