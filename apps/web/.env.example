# Base URL the browser uses to reach the VidGen API. Leave empty in local
# development so requests go through the Vite dev proxy on the same origin.
VITE_VIDGEN_API_BASE_URL=

# The local development identity sent as X-VidGen-User. Development only:
# T18 deliberately does not implement production authentication.
VITE_VIDGEN_DEV_USER=local-user
